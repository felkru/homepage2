---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArtCanvas from "../components/ArtCanvas.astro";
---

<SiteLayout title="404: Not Found">
    <div class="fof-bg">
        <ArtCanvas variant="nbody" seed={4} height="100%" />
        <div class="fof-fade"></div>
    </div>

    <div class="fof">
        <span class="mono fof-kicker">err 404 · off the manifold</span>
        <h1>404</h1>
        <p>The page you're looking for couldn't be found.</p>
        <a class="btn-accent" href="/">Home</a>
    </div>
</SiteLayout>

<style>
    .fof-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
    }
    .fof-fade {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 60% 60% at 50% 45%, rgba(10, 14, 20, 0.55), transparent 75%);
        pointer-events: none;
    }
    .fof {
        position: relative;
        z-index: 1;
        text-align: center;
        min-height: 62vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        pointer-events: none;
    }
    .fof-kicker {
        color: var(--amber);
    }
    .fof h1 {
        font-size: clamp(5rem, 18vw, 11rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        margin: 0;
        line-height: 0.9;
    }
    .fof p {
        font-size: 1.15rem;
        color: #c3ccda;
        margin: 0 0 1.2rem;
    }
    .fof .btn-accent {
        pointer-events: auto;
    }
    .fof-hint {
        margin-top: 1.6rem;
        opacity: 0.7;
    }
</style>
