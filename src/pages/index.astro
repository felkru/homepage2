---
import BaseHead from "../components/BaseHead.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import felixPro from "../assets/felix_pro.jpg";

const posts = (await getCollection("blog"))
    .filter((p) => p.data.published && p.data.homepage)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 6);

const description =
    "Felix Krückel — hardware-based AI verification, compute governance and EU tech policy. MIRI Technical Governance, EU policy advisor, Stanford CAIS research collaborator.";

const roles = [
    {
        org: "MIRI — Technical Governance Team",
        role: "Fellow",
        date: "2026 —",
        desc: "Building a multi-sensor GPU verification testbed: detecting and classifying ML workloads from physical side channels alone.",
        link: "https://url.felkru.com/gpu-testbed",
    },
    {
        org: "EU Digital Policy",
        role: "Policy Advisor",
        date: "2025 —",
        desc: "Advising on AI & robotics policy. Extensive engagement with leaders in EU digital policy — including Axel Voss and the Dutch Ministry of Foreign Affairs.",
        link: "https://copyright.felkru.com",
    },
    {
        org: "Stanford Center for AI Safety",
        role: "Research Collaborator",
        date: "2024 —",
        desc: "≈$25k grant for AI policy projects — tools that let policymakers engage hands-on with ML fundamentals.",
        link: "https://safeaigermany.org/projects-spring26/felix-duncan",
    },
    {
        org: "CORDA Fellowship — ETH Zürich",
        role: "Democracy Fellow",
        date: "2026 —",
        desc: "Capture-resistant reranking and collective epistemics for social platforms (Project P10).",
        link: "https://cordademocracy.org/projects",
    },
    {
        org: "SAIGE Spring 2026",
        role: "Incubator Mentor",
        date: "2026",
        desc: "Mentoring AI-safety founders alongside Duncan Eddy (Stanford HAI).",
        link: "https://safeaigermany.org/projects-spring26",
    },
];

const specs = [
    ["Nodes", "2 × AMD EPYC 7702 · 128 cores"],
    ["Accelerators", "12 × NVIDIA RTX 3090 · 24 GB"],
    ["Fabric", "ConnectX-6 · 200 Gb/s HDR"],
    ["Channels", "power · acoustic · EM · thermal"],
    ["Clock sync", "PTP · sub-microsecond"],
    ["Root of trust", "TPM attestation"],
];

const recs = [
    {
        title: "Do an Apart Research hackathon — with friends",
        desc: "Weekend-long research sprints, open to anyone, no credentials required. My most impactful publication grew out of one — and publishing with friends is the coolest thing ever.",
        link: "https://apartresearch.com",
        label: "apartresearch.com",
    },
    {
        title: "Subscribe to the AI Safety Events & Training newsletter",
        desc: "A weekly list of newly announced fellowships, programs and events. Most opportunities in this field have narrow application windows — this is how you stop missing them.",
        link: "https://www.aisafety.com/events-and-training",
        label: "aisafety.com/events-and-training",
    },
    {
        title: "Join your local AI-safety group — or build one",
        desc: "I founded AI Safety Aachen at my university. It unlocked far more than community: funding, the people I still work with, discounted Claude subscriptions for safety research via nonprofit plans, and the institutional credibility that opens doors for policy outreach.",
        link: "https://www.aisafety.com/communities",
        label: "find a group near you",
    },
];

const timeline = [
    ["next", "UC Berkeley → Stanford", "BISP semester at Berkeley, then a Stanford-supervised thesis (planned 2027)."],
    ["2026", "B.Sc. Informatics, RWTH Aachen", "Accelerated track — degree in 4 semesters instead of 6 (fastest 3% of cohort), Machine Learning specialization."],
    ["2026", "#1 — OpenMP/CUDA Optimization Challenge", "Kernel optimization on 96-core nodes with 4× H100; won outright on 2 of 3 problems."],
    ["2026", "Iliad Fellowship, London", "Intensive AI-safety research program — singular learning theory, developmental interpretability, agent foundations."],
    ["2025", "Computer Vision Lab, RWTH (Prof. Leibe)", "Only undergraduate researcher in the lab — transformer-based human pose estimation."],
    ["2024", "Process & Data Science under Prof. Wil van der Aalst", "Generalized sequence alignment for event data, shipped as a C-accelerated Python library."],
    ["2024", "Founded AI Safety Aachen e.V.", "Built the StanfordxRWTH AI Safety Forum — €25k+ fundraised; speakers incl. Clark Barrett, Axel Voss, Holger Hoos."],
    ["2023", "Founded Mealscanner", "Food-tech startup, NRW Founders Scholarship; received an exit offer — declined to pivot into AI policy."],
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Krückel — AI Verification & Compute Governance" description={description} image="/social_img.jpeg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>document.documentElement.classList.add("js");</script>
    </head>
    <body class="landing">
        <!-- NAV -->
        <nav id="nav">
            <a class="brand" href="/">
                <span class="brand-mark">FK</span>
                <span class="brand-name">Felix Krückel</span>
            </a>
            <div class="nav-links">
                <a href="#research">Research</a>
                <a href="#writing">Writing</a>
                <a href="#background">Background</a>
                <a href="#contact">Contact</a>
            </div>
            <a class="btn-accent nav-cta" href="https://url.felkru.com/meet" target="_blank" rel="noopener">Book a call</a>
        </nav>

        <!-- HERO -->
        <header class="hero">
            <canvas id="field"></canvas>
            <div class="hero-fade"></div>
            <div class="hero-inner">
                <p class="kicker" data-hero>
                    <span class="dot"></span>
                    Aachen, DE&ensp;→&ensp;Berkeley, CA · July 2026
                </p>
                <h1 data-hero>
                    AI governance needs<br />
                    <em>hardware that can’t be lied to.</em>
                </h1>
                <p class="hero-sub" data-hero>
                    I’m Felix Krückel. I build instruments that verify what’s actually running
                    on AI compute — and work with EU lawmakers to turn verification into
                    enforceable policy.
                </p>
                <p class="hero-roles mono" data-hero>
                    MIRI Technical Governance · EU Policy Advisor · Stanford CAIS · CORDA, ETH Zürich
                </p>
                <div class="hero-cta" data-hero>
                    <a class="btn-accent" href="https://url.felkru.com/meet" target="_blank" rel="noopener">Book a call</a>
                    <a class="btn-ghost" href="mailto:hi@felkru.com">hi@felkru.com</a>
                </div>
            </div>
            <p class="hero-legend mono">fig. 01 — GPU die · live core utilization · the thing my sensors listen to</p>
            <a class="scroll-hint mono" href="#now">scroll<span class="scroll-line"></span></a>
        </header>

        <main>
            <!-- 01 NOW -->
            <section id="now" class="section">
                <div class="section-head" data-reveal>
                    <span class="mono index">01</span>
                    <h2>Now</h2>
                    <span class="rule"></span>
                </div>
                <div class="roles-grid">
                    {
                        roles.map((r, i) => {
                            const Tag = r.link ? "a" : "article";
                            const props = r.link
                                ? { href: r.link, target: "_blank", rel: "noopener", class: "role-card is-link" }
                                : { class: "role-card" };
                            return (
                                <Tag {...props} data-reveal>
                                    <div class="role-top mono">
                                        <span>{String(i + 1).padStart(2, "0")}</span>
                                        <span>
                                            {r.date}
                                            {r.link && <span class="role-arrow">↗</span>}
                                        </span>
                                    </div>
                                    <h3>{r.org}</h3>
                                    <p class="role-role">{r.role}</p>
                                    <p class="role-desc">{r.desc}</p>
                                </Tag>
                            );
                        })
                    }
                </div>
                <p class="also mono" data-reveal>
                    also — Iliad Fellowship alum, London ’26 &nbsp;·&nbsp; Meridian Cambridge
                    Hardware Assurance ’26 &nbsp;·&nbsp; founder &amp; former chair,
                    <a href="https://aisafetyaachen.org" target="_blank" rel="noopener">AI Safety Aachen e.V.</a>
                </p>
            </section>

            <!-- 02 RESEARCH -->
            <section id="research" class="section">
                <div class="section-head" data-reveal>
                    <span class="mono index">02</span>
                    <h2>Research</h2>
                    <span class="rule"></span>
                </div>
                <p class="lede" data-reveal>
                    International AI agreements are only as strong as their verification layer.
                    Export controls, compute thresholds, training-run reporting — today it all
                    runs on trust. <em>My work replaces trust with measurement.</em>
                </p>

                <div class="testbed" data-reveal>
                    <div class="testbed-info">
                        <p class="mono testbed-label">Flagship — GPU verification testbed</p>
                        <h3>Reading workloads off the wall socket</h3>
                        <p>
                            A two-node datacenter testbed instrumented to detect and classify ML
                            workloads from physical emissions alone — no cooperation from the
                            operator required.
                        </p>
                        <a class="btn-ghost testbed-link" href="https://url.felkru.com/gpu-testbed" target="_blank" rel="noopener">Project page →</a>
                    </div>
                    <dl class="spec-sheet mono">
                        {
                            specs.map(([k, v]) => (
                                <div class="spec-row">
                                    <dt>{k}</dt>
                                    <dd>{v}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>

                <ol class="pubs">
                    <li data-reveal>
                        <span class="mono pub-date">2026</span>
                        <div>
                            <a href="/blog/ai-cluster-fingerprinting" class="pub-title"
                                >Fingerprinting All AI Cluster I/O Without Mutually Trusted Processors</a
                            >
                            <p class="pub-venue">Apart Research</p>
                        </div>
                    </li>
                    <li data-reveal>
                        <span class="mono pub-date">2025</span>
                        <div>
                            <a href="https://copyright.felkru.com" target="_blank" rel="noopener" class="pub-title"
                                >Creating a Market for AI Training Data Using Hardware-Based Verification</a
                            >
                            <p class="pub-venue">Presented to EU digital-policy leaders</p>
                        </div>
                    </li>
                    <li data-reveal>
                        <span class="mono pub-date">wip</span>
                        <div>
                            <span class="pub-title">Capture-Resistant Reranking for Social Platforms</span>
                            <p class="pub-venue">CORDA P10, ETH Zürich — in progress</p>
                        </div>
                    </li>
                </ol>
            </section>

            <!-- 03 WRITING -->
            <section id="writing" class="section">
                <div class="section-head" data-reveal>
                    <span class="mono index">03</span>
                    <h2>Writing &amp; experiments</h2>
                    <span class="rule"></span>
                </div>
                <div class="post-grid">
                    {
                        posts.map((post) => (
                            <a
                                class="post-card"
                                href={post.data.link ?? "/blog/" + post.slug}
                                target={post.data.link ? "_blank" : "_self"}
                                data-reveal
                            >
                                <div class="post-img">
                                    <Image
                                        src={post.data.heroImage}
                                        alt={post.data.title}
                                        widths={[480, 720]}
                                        sizes="(max-width: 700px) 95vw, 420px"
                                    />
                                </div>
                                <h3>{post.data.title}</h3>
                                <p>{post.data.description}</p>
                            </a>
                        ))
                    }
                </div>
                <a href="/blog" class="btn-ghost more-link" data-reveal>All writing →</a>
            </section>

            <!-- 04 BACKGROUND -->
            <section id="background" class="section">
                <div class="section-head" data-reveal>
                    <span class="mono index">04</span>
                    <h2>Background</h2>
                    <span class="rule"></span>
                </div>
                <div class="bg-grid">
                    <figure class="bg-photo" data-reveal>
                        <Image src={felixPro} alt="Felix Krückel at work" widths={[480, 900]} sizes="(max-width: 900px) 92vw, 420px" />
                        <figcaption class="mono">Felix Krückel · Aachen</figcaption>
                    </figure>
                    <ol class="timeline">
                        {
                            timeline.map(([year, title, desc]) => (
                                <li data-reveal>
                                    <span class="mono tl-year">{year}</span>
                                    <div>
                                        <h3>{title}</h3>
                                        <p>{desc}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ol>
                </div>
            </section>

            <!-- 05 START HERE -->
            <section id="start" class="section">
                <div class="section-head" data-reveal>
                    <span class="mono index">05</span>
                    <h2>Getting into AI safety</h2>
                    <span class="rule"></span>
                </div>
                <p class="lede" data-reveal>
                    People ask how to get started. Three things gave me a
                    disproportionate return — <em>none of them require permission.</em>
                </p>
                <ol class="recs">
                    {
                        recs.map((r, i) => (
                            <li data-reveal>
                                <span class="mono rec-num">{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <h3>{r.title}</h3>
                                    <p>{r.desc}</p>
                                    <a class="rec-link mono" href={r.link} target="_blank" rel="noopener">
                                        {r.label} →
                                    </a>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>

            <!-- 06 CONTACT -->
            <section id="contact" class="section contact">
                <div class="section-head" data-reveal>
                    <span class="mono index">06</span>
                    <h2>Contact</h2>
                    <span class="rule"></span>
                </div>
                <p class="lede" data-reveal>
                    Working on compute verification, hardware security for AI, or EU tech
                    policy? <em>I want to hear about it.</em>
                </p>
                <div class="contact-row" data-reveal>
                    <a class="btn-accent" href="https://url.felkru.com/meet" target="_blank" rel="noopener">Book a call</a>
                    <a class="btn-ghost" href="mailto:hi@felkru.com">hi@felkru.com</a>
                    <a class="btn-ghost" href="https://github.com/felkru" target="_blank" rel="noopener">GitHub</a>
                    <a class="btn-ghost" href="https://www.linkedin.com/in/felix-krueckel/" target="_blank" rel="noopener">LinkedIn</a>
                </div>
            </section>
        </main>

        <footer class="site-footer mono">
            <span>© 2026 Felix Krückel</span>
            <span class="foot-links">
                <a href="/blog">writing</a>
                <a href="/resume">resume</a>
                <a href="/rss.xml">rss</a>
            </span>
        </footer>

        <style is:global>
            .landing {
                --bg: #0a0e14;
                --panel: #0f1520;
                --line: rgba(150, 170, 200, 0.14);
                --line-strong: rgba(150, 170, 200, 0.3);
                --text: #e8edf5;
                --muted: #8b96a8;
                --teal: #5eead4;
                --ice: #7dd3fc;
                --amber: #f5a623;
                --font-display: "Space Grotesk", system-ui, sans-serif;
                --font-mono: "IBM Plex Mono", ui-monospace, monospace;
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: var(--font-display);
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }
            .landing ::selection {
                background: var(--teal);
                color: #06241d;
            }
            .landing .mono {
                font-family: var(--font-mono);
                font-size: 0.78rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--muted);
            }

            /* ---------- nav ---------- */
            #nav {
                position: fixed;
                inset: 0 0 auto 0;
                z-index: 50;
                display: flex;
                align-items: center;
                gap: 2rem;
                padding: 0.9rem clamp(1.2rem, 4vw, 3rem);
                transition: background 0.3s, border-color 0.3s;
                border-bottom: 1px solid transparent;
            }
            #nav.scrolled {
                background: rgba(10, 14, 20, 0.82);
                backdrop-filter: blur(12px);
                border-bottom-color: var(--line);
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 0.7rem;
                text-decoration: none;
                color: var(--text);
                margin-right: auto;
            }
            .brand-mark {
                font-family: var(--font-mono);
                font-weight: 500;
                font-size: 0.85rem;
                color: var(--teal);
                border: 1px solid var(--line-strong);
                padding: 0.28rem 0.45rem;
                border-radius: 4px;
            }
            .brand-name {
                font-weight: 600;
                letter-spacing: 0.01em;
            }
            .nav-links {
                display: flex;
                gap: 1.6rem;
            }
            .nav-links a {
                color: var(--muted);
                text-decoration: none;
                font-size: 0.92rem;
                transition: color 0.2s;
            }
            .nav-links a:hover {
                color: var(--text);
            }

            .btn-accent,
            .btn-ghost {
                font-family: var(--font-mono);
                font-size: 0.8rem;
                letter-spacing: 0.04em;
                text-decoration: none;
                padding: 0.62rem 1.15rem;
                border-radius: 6px;
                transition: transform 0.15s, background 0.2s, color 0.2s, border-color 0.2s;
                white-space: nowrap;
            }
            .btn-accent {
                background: var(--teal);
                color: #06241d;
                font-weight: 500;
            }
            .btn-accent:hover {
                transform: translateY(-2px);
                background: #8ef2e0;
            }
            .btn-ghost {
                color: var(--text);
                border: 1px solid var(--line-strong);
            }
            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal);
            }

            /* ---------- hero ---------- */
            .hero {
                position: relative;
                min-height: 100svh;
                display: flex;
                align-items: center;
            }
            #field {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
            }
            .hero-fade {
                position: absolute;
                inset: 0;
                background:
                    linear-gradient(to bottom, rgba(10, 14, 20, 0.4), transparent 30%, transparent 62%, var(--bg) 96%),
                    radial-gradient(ellipse 80% 75% at 30% 52%, rgba(10, 14, 20, 0.78), transparent 72%);
                pointer-events: none;
            }
            .hero-inner {
                position: relative;
                z-index: 2;
                padding: 7rem clamp(1.2rem, 5vw, 4rem) 5rem;
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
            }
            .kicker {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                font-family: var(--font-mono);
                font-size: 0.78rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--muted);
                margin: 0 0 1.6rem;
            }
            .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--teal);
                box-shadow: 0 0 10px var(--teal);
                animation: pulse 2.4s ease-in-out infinite;
            }
            @keyframes pulse {
                50% { opacity: 0.35; }
            }
            .hero h1 {
                font-size: clamp(2.4rem, 6.4vw, 5.2rem);
                line-height: 1.04;
                font-weight: 700;
                letter-spacing: -0.025em;
                margin: 0 0 1.6rem;
                max-width: 17ch;
            }
            .hero h1 em {
                font-style: normal;
                color: var(--teal);
            }
            .hero-sub {
                font-size: clamp(1.02rem, 1.6vw, 1.25rem);
                line-height: 1.6;
                color: #c3ccda;
                max-width: 56ch;
                margin: 0 0 1.4rem;
            }
            .hero-roles {
                margin: 0 0 2.4rem;
                line-height: 1.9;
            }
            .hero-cta {
                display: flex;
                gap: 0.9rem;
                flex-wrap: wrap;
            }
            .hero-legend {
                position: absolute;
                bottom: 2.2rem;
                left: clamp(1.2rem, 5vw, 4rem);
                z-index: 2;
                margin: 0;
                font-size: 0.68rem;
                color: #5d6878;
            }
            .scroll-hint {
                position: absolute;
                bottom: 2rem;
                right: clamp(1.2rem, 4vw, 3rem);
                z-index: 2;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 0.6rem;
                text-decoration: none;
            }
            .scroll-line {
                width: 1px;
                height: 52px;
                background: var(--line-strong);
                position: relative;
                overflow: hidden;
            }
            .scroll-line::after {
                content: "";
                position: absolute;
                inset: 0 0 auto;
                height: 18px;
                background: var(--teal);
                animation: drip 1.8s ease-in-out infinite;
            }
            @keyframes drip {
                from { transform: translateY(-20px); }
                to { transform: translateY(60px); }
            }

            /* ---------- sections ---------- */
            .section {
                max-width: 1200px;
                margin: 0 auto;
                padding: clamp(4rem, 9vw, 7.5rem) clamp(1.2rem, 5vw, 4rem) 0;
            }
            .section-head {
                display: flex;
                align-items: baseline;
                gap: 1.1rem;
                margin-bottom: clamp(2rem, 4vw, 3.2rem);
            }
            .section-head .index {
                color: var(--teal);
            }
            .section-head h2 {
                font-size: clamp(1.7rem, 3.4vw, 2.6rem);
                font-weight: 600;
                letter-spacing: -0.02em;
                margin: 0;
                white-space: nowrap;
            }
            .rule {
                flex: 1;
                height: 1px;
                background: var(--line);
                transform-origin: left;
            }
            .lede {
                font-size: clamp(1.15rem, 2.2vw, 1.55rem);
                line-height: 1.55;
                max-width: 46ch;
                color: #c3ccda;
                margin: 0 0 clamp(2.2rem, 4vw, 3.4rem);
            }
            .lede em {
                font-style: normal;
                color: var(--teal);
            }

            /* roles */
            .roles-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
                gap: 1px;
                background: var(--line);
                border: 1px solid var(--line);
            }
            .role-card {
                background: var(--bg);
                padding: 1.6rem 1.5rem 1.7rem;
                transition: background 0.25s;
                display: block;
                color: inherit;
                text-decoration: none;
            }
            .role-card:hover {
                background: var(--panel);
            }
            .role-card.is-link:hover h3 {
                color: var(--teal);
            }
            .role-arrow {
                color: var(--muted);
                font-size: 0.85em;
                margin-left: 0.4rem;
                transition: color 0.2s, transform 0.2s;
                display: inline-block;
            }
            .role-card.is-link:hover .role-arrow {
                color: var(--teal);
                transform: translate(2px, -2px);
            }
            .role-top {
                display: flex;
                justify-content: space-between;
                margin-bottom: 1.4rem;
            }
            .role-card h3 {
                font-size: 1.08rem;
                font-weight: 600;
                margin: 0 0 0.2rem;
            }
            .role-role {
                color: var(--teal);
                font-size: 0.92rem;
                margin: 0 0 0.75rem;
            }
            .role-desc {
                color: var(--muted);
                font-size: 0.92rem;
                line-height: 1.55;
                margin: 0;
            }
            .also {
                margin-top: 1.4rem;
                line-height: 2;
            }
            .also a {
                color: var(--muted);
                text-decoration: none;
                border-bottom: 1px solid var(--line-strong);
                transition: color 0.2s, border-color 0.2s;
            }
            .also a:hover {
                color: var(--teal);
                border-bottom-color: var(--teal);
            }

            /* testbed */
            .testbed {
                display: grid;
                grid-template-columns: 1.1fr 1fr;
                gap: clamp(1.5rem, 4vw, 3.5rem);
                border: 1px solid var(--line);
                background:
                    radial-gradient(ellipse 70% 90% at 85% 10%, rgba(94, 234, 212, 0.05), transparent 60%),
                    var(--panel);
                padding: clamp(1.5rem, 3.5vw, 2.8rem);
                margin-bottom: clamp(2.5rem, 5vw, 4rem);
            }
            .testbed-label {
                color: var(--amber);
                margin: 0 0 1rem;
            }
            .testbed-info h3 {
                font-size: clamp(1.3rem, 2.4vw, 1.8rem);
                letter-spacing: -0.015em;
                margin: 0 0 0.9rem;
            }
            .testbed-info p {
                color: var(--muted);
                line-height: 1.65;
                margin: 0;
            }
            .testbed-link {
                display: inline-block;
                margin-top: 1.4rem;
            }
            .spec-sheet {
                margin: 0;
                align-self: center;
            }
            .spec-row {
                display: flex;
                justify-content: space-between;
                gap: 1.5rem;
                padding: 0.68rem 0;
                border-bottom: 1px dashed var(--line);
            }
            .spec-row:last-child {
                border-bottom: none;
            }
            .spec-row dt {
                color: var(--muted);
            }
            .spec-row dd {
                margin: 0;
                color: var(--text);
                text-align: right;
                text-transform: none;
                font-family: var(--font-mono);
                font-size: 0.8rem;
            }

            /* publications */
            .pubs {
                list-style: none;
                margin: 0;
                padding: 0;
            }
            .pubs li {
                display: flex;
                gap: clamp(1rem, 3vw, 2.5rem);
                padding: 1.3rem 0;
                border-top: 1px solid var(--line);
                align-items: baseline;
            }
            .pub-date {
                color: var(--teal);
                min-width: 3.2rem;
            }
            .pub-title {
                color: var(--text);
                font-size: clamp(1.05rem, 1.8vw, 1.3rem);
                font-weight: 500;
                text-decoration: none;
                line-height: 1.4;
            }
            a.pub-title:hover {
                color: var(--teal);
            }
            .pub-venue {
                color: var(--muted);
                font-size: 0.88rem;
                margin: 0.3rem 0 0;
            }

            /* writing */
            .post-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: clamp(1.4rem, 3vw, 2.2rem);
            }
            .post-card {
                text-decoration: none;
                color: var(--text);
                display: block;
            }
            .post-img {
                border: 1px solid var(--line);
                overflow: hidden;
                margin-bottom: 0.95rem;
            }
            .post-img img {
                width: 100%;
                height: auto;
                display: block;
                transition: transform 0.45s cubic-bezier(0.2, 0.6, 0.2, 1);
            }
            .post-card:hover .post-img img {
                transform: scale(1.04);
            }
            .post-card h3 {
                font-size: 1.05rem;
                font-weight: 600;
                margin: 0 0 0.35rem;
            }
            .post-card:hover h3 {
                color: var(--teal);
            }
            .post-card p {
                color: var(--muted);
                font-size: 0.88rem;
                line-height: 1.5;
                margin: 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .more-link {
                display: inline-block;
                margin-top: 2.2rem;
            }

            /* background */
            .bg-grid {
                display: grid;
                grid-template-columns: minmax(280px, 420px) 1fr;
                gap: clamp(2rem, 5vw, 4.5rem);
                align-items: start;
            }
            .bg-photo {
                margin: 0;
                position: sticky;
                top: 6rem;
            }
            .bg-photo img {
                width: 100%;
                height: auto;
                display: block;
                border: 1px solid var(--line);
                filter: saturate(0.88) contrast(1.02);
            }
            .bg-photo figcaption {
                margin-top: 0.7rem;
            }
            .timeline {
                list-style: none;
                margin: 0;
                padding: 0;
            }
            .timeline li {
                display: flex;
                gap: clamp(1rem, 2.5vw, 2rem);
                padding: 1.15rem 0;
                border-top: 1px solid var(--line);
            }
            .tl-year {
                color: var(--teal);
                min-width: 3.2rem;
                padding-top: 0.2rem;
            }
            .timeline h3 {
                font-size: 1.02rem;
                font-weight: 600;
                margin: 0 0 0.3rem;
            }
            .timeline p {
                color: var(--muted);
                font-size: 0.9rem;
                line-height: 1.55;
                margin: 0;
            }

            /* recommendations */
            .recs {
                list-style: none;
                margin: 0;
                padding: 0;
            }
            .recs li {
                display: flex;
                gap: clamp(1rem, 3vw, 2.5rem);
                padding: 1.5rem 0;
                border-top: 1px solid var(--line);
                align-items: baseline;
            }
            .rec-num {
                color: var(--teal);
                min-width: 3.2rem;
            }
            .recs h3 {
                font-size: clamp(1.05rem, 1.8vw, 1.3rem);
                font-weight: 600;
                margin: 0 0 0.45rem;
            }
            .recs p {
                color: var(--muted);
                font-size: 0.95rem;
                line-height: 1.6;
                max-width: 62ch;
                margin: 0 0 0.7rem;
            }
            .rec-link {
                color: var(--teal);
                text-decoration: none;
            }
            .rec-link:hover {
                text-decoration: underline;
            }

            /* contact + footer */
            .contact {
                padding-bottom: clamp(4rem, 8vw, 7rem);
            }
            .contact-row {
                display: flex;
                gap: 0.9rem;
                flex-wrap: wrap;
            }
            .site-footer {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
                max-width: 1200px;
                margin: 0 auto;
                padding: 1.6rem clamp(1.2rem, 5vw, 4rem) 2.2rem;
                border-top: 1px solid var(--line);
            }
            .foot-links {
                display: flex;
                gap: 1.4rem;
            }
            .site-footer a {
                color: var(--muted);
                text-decoration: none;
            }
            .site-footer a:hover {
                color: var(--teal);
            }

            /* reveal initial state (JS removes) */
            .js [data-reveal] {
                opacity: 0;
                transform: translateY(26px);
            }
            .js [data-hero] {
                opacity: 0;
                transform: translateY(30px);
            }

            @media (max-width: 760px) {
                .nav-links { display: none; }
                .brand-name { display: none; }
                .bg-grid { grid-template-columns: 1fr; }
                .bg-photo { position: static; max-width: 420px; }
                .testbed { grid-template-columns: 1fr; }
                .scroll-hint { display: none; }
                .hero-legend { position: static; margin-top: 2.2rem; }
                .spec-row dd { font-size: 0.72rem; }
            }
            @media (prefers-reduced-motion: reduce) {
                .js [data-reveal], .js [data-hero] {
                    opacity: 1 !important;
                    transform: none !important;
                }
                .dot, .scroll-line::after { animation: none; }
            }
        </style>

        <script>
            import * as THREE from "three";
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            /* ------------- Three.js GPU die — live utilization map ------------- */
            const canvas = document.getElementById("field");
            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 120);

            // grid of cores, grouped into SM blocks separated by channels
            const NX = 48, NZ = 30, SMX = 8, SMZ = 6;
            const CELL = 0.4, GAP = 0.1, CH = 0.42;
            const stepX = CELL + GAP, stepZ = CELL + GAP;
            const px = (ix) => ix * stepX + Math.floor(ix / SMX) * CH;
            const pz = (iz) => iz * stepZ + Math.floor(iz / SMZ) * CH;
            const dieW = px(NX - 1) + CELL, dieD = pz(NZ - 1) + CELL;

            const boxGeo = new THREE.BoxGeometry(CELL, 1, CELL);
            boxGeo.translate(0, 0.5, 0); // grow upward from the substrate

            const uniforms = {
                uTime: { value: 0 },
                uMouse: { value: new THREE.Vector2(-10, -10) },
            };
            const mat = new THREE.ShaderMaterial({
                uniforms,
                vertexShader: /* glsl */ `
                    attribute vec2 aCell;
                    uniform float uTime;
                    uniform vec2 uMouse;
                    varying float vU;
                    varying float vScan;
                    varying vec3 vN;
                    float hash(vec2 p) {
                        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
                    }
                    void main() {
                        vec2 c = aCell;
                        float t = uTime;
                        // workloads: kernels migrating across the die
                        vec2 k1 = vec2(0.5 + 0.34 * sin(t * 0.23), 0.5 + 0.34 * cos(t * 0.17));
                        vec2 k2 = vec2(0.5 + 0.38 * cos(t * 0.13 + 2.1), 0.5 + 0.30 * sin(t * 0.19 + 4.0));
                        vec2 k3 = vec2(0.5 + 0.30 * sin(t * 0.11 + 1.0), 0.5 + 0.38 * cos(t * 0.27 + 0.6));
                        float u = 0.0;
                        u += 0.95 * exp(-dot(c - k1, c - k1) * 22.0);
                        u += 0.80 * exp(-dot(c - k2, c - k2) * 30.0);
                        u += 0.70 * exp(-dot(c - k3, c - k3) * 26.0);
                        // dispatch wavefront sweeping down the rows
                        float wf = fract(t * 0.06);
                        u += 0.30 * exp(-pow(c.y - wf * 1.3 + 0.15, 2.0) * 90.0);
                        // per-core activity flicker
                        u += 0.16 * step(0.72, hash(floor(c * vec2(48.0, 30.0)) + floor(t * 3.0)));
                        // cursor = probe
                        u += 0.9 * exp(-dot(c - uMouse, c - uMouse) * 50.0);
                        u = clamp(u, 0.0, 1.3);
                        // telemetry scanline
                        float scan = exp(-pow(c.x - fract(t * 0.085) * 1.3 + 0.15, 2.0) * 160.0);
                        vec3 pos = position;
                        pos.y *= (0.14 + u * 1.05 + scan * 0.22);
                        vec4 world = instanceMatrix * vec4(pos, 1.0);
                        gl_Position = projectionMatrix * modelViewMatrix * world;
                        vU = u;
                        vScan = scan;
                        vN = normal;
                    }`,
                fragmentShader: /* glsl */ `
                    precision mediump float;
                    varying float vU;
                    varying float vScan;
                    varying vec3 vN;
                    void main() {
                        vec3 idle = vec3(0.055, 0.085, 0.125);
                        vec3 teal = vec3(0.369, 0.918, 0.831);
                        vec3 amber = vec3(0.961, 0.651, 0.137);
                        vec3 col = mix(idle, teal, smoothstep(0.06, 1.0, vU) * 0.95);
                        col = mix(col, amber, vScan * 0.85);
                        // fake lighting: bright tops, dim sides
                        float shade = 0.35 + 0.65 * max(vN.y, 0.0) + 0.12 * max(vN.x, 0.0);
                        gl_FragColor = vec4(col * shade, 1.0);
                    }`,
            });

            const mesh = new THREE.InstancedMesh(boxGeo, mat, NX * NZ);
            const cells = new Float32Array(NX * NZ * 2);
            const m4 = new THREE.Matrix4();
            let i = 0;
            for (let ix = 0; ix < NX; ix++) {
                for (let iz = 0; iz < NZ; iz++) {
                    m4.makeTranslation(px(ix) - dieW / 2, 0, pz(iz) - dieD / 2);
                    mesh.setMatrixAt(i, m4);
                    cells[i * 2] = ix / (NX - 1);
                    cells[i * 2 + 1] = iz / (NZ - 1);
                    i++;
                }
            }
            boxGeo.setAttribute("aCell", new THREE.InstancedBufferAttribute(cells, 2));

            // package substrate under the die
            const sub = new THREE.Mesh(
                new THREE.BoxGeometry(dieW + 2.4, 0.5, dieD + 2.4),
                new THREE.MeshBasicMaterial({ color: 0x0d1320 })
            );
            sub.position.y = -0.26;
            const edge = new THREE.LineSegments(
                new THREE.EdgesGeometry(sub.geometry),
                new THREE.LineBasicMaterial({ color: 0x5eead4, transparent: true, opacity: 0.28 })
            );
            edge.position.y = -0.26;

            const die = new THREE.Group();
            die.add(mesh, sub, edge);
            die.rotation.y = -0.62;
            scene.add(die);

            function layout() {
                const w = canvas.clientWidth, h = canvas.clientHeight;
                renderer.setSize(w, h, false);
                camera.aspect = w / h;
                const wide = w / h > 1.05;
                // desktop: die anchored bottom-right, clear of the headline; mobile: low and centered
                camera.position.set(0, 12, 22);
                camera.lookAt(2, -3, 0);
                die.position.set(wide ? 13.5 : 0, wide ? -7.4 : -7, wide ? -1 : -3);
                die.scale.setScalar(wide ? 0.95 : 0.7);
                camera.updateProjectionMatrix();
            }
            layout();
            window.addEventListener("resize", layout);

            const ndc = new THREE.Vector2(0, 0);
            const ndcTarget = new THREE.Vector2(0, 0);
            window.addEventListener("pointermove", (e) => {
                ndcTarget.set((e.clientX / window.innerWidth) * 2 - 1, -((e.clientY / window.innerHeight) * 2 - 1));
            }, { passive: true });

            let visible = true;
            new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

            const raycaster = new THREE.Raycaster();
            const floor = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
            const hit = new THREE.Vector3();
            const t0 = performance.now();
            function tick() {
                if (visible && !document.hidden) {
                    uniforms.uTime.value = (performance.now() - t0) / 1000;
                    ndc.lerp(ndcTarget, 0.06);
                    // probe: project cursor onto the die surface
                    raycaster.setFromCamera(ndc, camera);
                    if (raycaster.ray.intersectPlane(floor, hit)) {
                        const local = die.worldToLocal(hit.clone());
                        uniforms.uMouse.value.set(
                            (local.x + dieW / 2) / dieW,
                            (local.z + dieD / 2) / dieD
                        );
                    }
                    // subtle parallax
                    camera.position.x = ndc.x * 0.9;
                    camera.position.y = 12 - ndc.y * 0.7;
                    camera.lookAt(2, -3, 0);
                    renderer.render(scene, camera);
                }
                if (!reduced) requestAnimationFrame(tick);
            }
            if (reduced) {
                uniforms.uTime.value = 12;
                renderer.render(scene, camera);
            } else {
                tick();
            }

            /* ---------------- GSAP choreography ---------------- */
            gsap.registerPlugin(ScrollTrigger);

            const nav = document.getElementById("nav");
            ScrollTrigger.create({
                start: 60,
                onUpdate: (self) => nav.classList.toggle("scrolled", self.scroll() > 60),
            });
            nav.classList.toggle("scrolled", window.scrollY > 60);

            if (!reduced) {
                gsap.to("[data-hero]", {
                    opacity: 1,
                    y: 0,
                    duration: 1.1,
                    ease: "power3.out",
                    stagger: 0.12,
                    delay: 0.15,
                });

                gsap.utils.toArray("[data-reveal]").forEach((el) => {
                    gsap.to(el, {
                        opacity: 1,
                        y: 0,
                        duration: 0.9,
                        ease: "power3.out",
                        scrollTrigger: { trigger: el, start: "top 88%" },
                    });
                });

                gsap.utils.toArray(".rule").forEach((el) => {
                    gsap.from(el, {
                        scaleX: 0,
                        duration: 1.2,
                        ease: "power3.inOut",
                        scrollTrigger: { trigger: el, start: "top 90%" },
                    });
                });
            }
        </script>
    </body>
</html>
