---
import SiteLayout from "@layouts/SiteLayout.astro";
import PostCard from "@components/PostCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
    const all_posts = await getCollection("blog");
    const all_tags = all_posts.flatMap((post) => {
        return post.data.tags || [];
    });

    return all_tags.flatMap((tag) => {
        const filtred_posts = all_posts.filter((post) => {
            return post.data.tags?.includes(tag) && post.data.published;
        });
        return paginate(filtred_posts, {
            params: { tag },
            pageSize: 10,
        });
    });
}

const { page } = Astro.props;
const params = Astro.params;
---

<SiteLayout title={params.tag + " posts"} active="writing" wide={true}>
    <div class="page-head" data-reveal>
        <span class="mono index">tag</span>
        <h1>{params.tag}</h1>
        <span class="rule"></span>
    </div>
    <p class="lede" data-reveal>Posts tagged <em>{params.tag}</em>.</p>

    {
        page.data.length === 0 ? (
            <div class="empty" data-reveal>
                <p class="empty-title">Sorry!</p>
                <p>There are no blog posts for this filter. Check back later!</p>
            </div>
        ) : (
            <div class="post-grid">
                {page.data.map((post) => (
                    <PostCard
                        title={post.data.title}
                        img={post.data.heroImage}
                        desc={post.data.description}
                        url={post.data.link ?? "/blog/" + post.slug}
                        target={post.data.link ? "_blank" : "_self"}
                        badge={post.data.badge}
                        tags={post.data.tags}
                    />
                ))}
            </div>
        )
    }

    <div class="pager mono">
        {page.url.prev ? <a href={page.url.prev}>← Recent posts</a> : <span></span>}
        {page.url.next ? <a href={page.url.next}>Older posts →</a> : <span></span>}
        <a href="/blog" class="all-link">all writing</a>
    </div>
</SiteLayout>

<style>
    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: clamp(1.3rem, 3vw, 2rem);
    }
    .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        margin-top: 3rem;
    }
    .pager a {
        color: var(--text);
        text-decoration: none;
        border: 1px solid var(--line-strong);
        border-radius: 6px;
        padding: 0.6rem 1.1rem;
        transition: border-color 0.2s, color 0.2s;
    }
    .pager a:hover {
        border-color: var(--teal);
        color: var(--teal);
    }
    .pager .all-link {
        margin-left: auto;
    }
    .empty {
        border: 1px solid var(--line);
        border-left: 3px solid var(--amber);
        border-radius: 8px;
        padding: 1.2rem 1.4rem;
        color: var(--muted);
    }
    .empty-title {
        color: var(--text);
        font-weight: 600;
        margin: 0 0 0.3rem;
    }
</style>
