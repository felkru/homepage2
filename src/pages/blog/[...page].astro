---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/PostCard.astro";
import ArtCanvas from "../../components/ArtCanvas.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
    let posts = await getCollection("blog");
    posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    posts = posts.filter((post) => post.data.published);
    return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<SiteLayout title="Writing" active="writing" wide={true}>
    <section class="blog-hero" data-reveal>
        <ArtCanvas variant="flow" seed={7} height="100%" />
        <div class="blog-hero-fade"></div>
        <div class="blog-hero-text">
            <span class="mono">fig. — generative flow field · move your cursor</span>
            <h1>Writing &amp; experiments</h1>
        </div>
    </section>

    {
        page.data.length === 0 ? (
            <div class="empty" data-reveal>
                <p class="empty-title">Sorry!</p>
                <p>There are no blog posts to show at the moment. Check back later!</p>
            </div>
        ) : (
            <div class="post-grid">
                {page.data.map((post) => (
                    <PostCard
                        title={post.data.title}
                        img={post.data.heroImage}
                        desc={post.data.description}
                        url={post.data.link ?? "/blog/" + post.slug}
                        target={post.data.link ? "_blank" : "_self"}
                        badge={post.data.badge}
                        tags={post.data.tags}
                    />
                ))}
            </div>
        )
    }

    <div class="pager mono">
        {page.url.prev ? <a href={page.url.prev}>← Recent posts</a> : <span></span>}
        {page.url.next ? <a href={page.url.next}>Older posts →</a> : <span></span>}
    </div>
</SiteLayout>

<style>
    .blog-hero {
        position: relative;
        height: clamp(200px, 30vw, 300px);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: clamp(2rem, 5vw, 3.5rem);
    }
    .blog-hero-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 30%,
            rgba(10, 14, 20, 0.55) 75%,
            rgba(10, 14, 20, 0.9) 100%
        );
        pointer-events: none;
    }
    .blog-hero-text {
        position: absolute;
        left: clamp(1.2rem, 3vw, 2.2rem);
        bottom: clamp(1rem, 3vw, 1.8rem);
        pointer-events: none;
    }
    .blog-hero-text h1 {
        font-size: clamp(2rem, 5vw, 3.4rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        margin: 0.3rem 0 0;
    }
    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: clamp(1.3rem, 3vw, 2rem);
    }
    .pager {
        display: flex;
        justify-content: space-between;
        margin-top: 3rem;
    }
    .pager a {
        color: var(--text);
        text-decoration: none;
        border: 1px solid var(--line-strong);
        border-radius: 6px;
        padding: 0.6rem 1.1rem;
        transition: border-color 0.2s, color 0.2s;
    }
    .pager a:hover {
        border-color: var(--teal);
        color: var(--teal);
    }
    .empty {
        border: 1px solid var(--line);
        border-left: 3px solid var(--amber);
        border-radius: 8px;
        padding: 1.2rem 1.4rem;
        color: var(--muted);
    }
    .empty-title {
        color: var(--text);
        font-weight: 600;
        margin: 0 0 0.3rem;
    }
</style>
