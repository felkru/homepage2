---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArtCanvas from "../components/ArtCanvas.astro";
import { Image } from "astro:assets";
import Felix from "../assets/contact_new.jpeg";

const fullName = import.meta.env.PUBLIC_FULL_NAME;
---

<SiteLayout title="Contact" active="contact">
    <div class="page-head" data-reveal>
        <span class="mono index">→</span>
        <h1>Let's get in touch</h1>
        <span class="rule"></span>
    </div>

    <div class="contact-grid">
        <figure class="contact-photo" data-reveal>
            <Image src={Felix} alt={fullName} widths={[480, 720]} sizes="(max-width: 760px) 92vw, 360px" loading="eager" />
        </figure>

        <div class="contact-body">
            <p class="lede" data-reveal>
                Working on compute verification, hardware security for AI, or EU tech
                policy? I want to hear about it. The fastest way to reach me is to
                grab a slot directly:
            </p>

            <div class="contact-actions" data-reveal>
                <a class="btn-accent" href="https://url.felkru.com/meet" target="_blank" rel="noopener">Book a call</a>
            </div>

            <div class="contact-block" data-reveal>
                <span class="mono label">Email</span>
                <a href="mailto:hi@felkru.com" class="contact-link">hi@felkru.com</a>
            </div>

            <div class="contact-block" data-reveal>
                <span class="mono label">Social</span>
                <div class="contact-socials">
                    <a class="btn-ghost" href="https://www.linkedin.com/in/felix-krueckel/" target="_blank" rel="noopener">LinkedIn</a>
                    <a class="btn-ghost" href="https://github.com/felkru" target="_blank" rel="noopener">GitHub</a>
                </div>
            </div>

            <p class="contact-loc mono" data-reveal>
                Based in Aachen until late June 2026 · Berkeley, CA from July.
            </p>
        </div>
    </div>

    <section class="contact-art" data-reveal>
        <ArtCanvas variant="constellation" seed={11} height="220px" />
        <span class="mono art-caption">particle constellation · drag your cursor through it</span>
    </section>
</SiteLayout>

<style>
    .contact-grid {
        display: grid;
        grid-template-columns: minmax(220px, 340px) 1fr;
        gap: clamp(1.5rem, 5vw, 3.5rem);
        align-items: start;
    }
    .contact-photo {
        margin: 0;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--line);
    }
    .contact-photo :global(img) {
        width: 100%;
        height: auto;
        display: block;
        filter: saturate(0.92) contrast(1.02);
    }
    .contact-block {
        margin-top: 1.8rem;
    }
    .contact-block .label {
        display: block;
        color: var(--teal);
        margin-bottom: 0.5rem;
    }
    .contact-link {
        font-size: 1.15rem;
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid var(--line-strong);
    }
    .contact-link:hover {
        color: var(--teal);
        border-bottom-color: var(--teal);
    }
    .contact-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }
    .contact-loc {
        margin-top: 2.4rem;
        text-transform: none;
        opacity: 0.8;
    }
    .contact-art {
        position: relative;
        margin-top: clamp(3rem, 7vw, 5rem);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }
    .art-caption {
        position: absolute;
        left: 1rem;
        bottom: 0.8rem;
        pointer-events: none;
        font-size: 0.66rem;
    }
    @media (max-width: 760px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
        .contact-photo {
            max-width: 360px;
        }
    }
</style>
