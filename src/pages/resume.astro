---
import BaseHead from "../components/BaseHead.astro";
import SiteBackground from "../components/SiteBackground.astro";

const description =
    "Resume of Felix Krückel — hardware-based AI verification, compute governance and EU tech policy.";

const experience = [
    {
        org: "MIRI — Technical Governance Team",
        role: "Fellow",
        date: "2026 — present",
        loc: "Remote / Berkeley, CA",
        points: [
            "Building a two-node datacenter testbed (2× EPYC 7702, 12× RTX 3090, 200 Gb/s HDR fabric) instrumented for power, acoustic, EM and thermal side channels with sub-µs PTP sync and TPM attestation.",
            "Goal: detect and classify ML workloads from physical emissions alone — a verification primitive for international compute agreements.",
            "Project page: url.felkru.com/gpu-testbed",
        ],
    },
    {
        org: "EU Digital Policy",
        role: "Policy Advisor (AI & Robotics)",
        date: "2025 — present",
        loc: "Brussels / remote",
        points: [
            "Advising on AI and robotics policy; extensive engagement with leaders in EU digital policy, including Axel Voss and the Dutch Ministry of Foreign Affairs.",
            "Contributing analysis on trusted/confidential AI as a near-term EU policy priority.",
        ],
    },
    {
        org: "CORDA Democracy Fellowship — ETH Zürich",
        role: "Fellow, Project P10",
        date: "2026",
        loc: "Remote",
        points: [
            "Research on collective epistemics and capture-resistant reranking for social platforms; co-authored paper in progress.",
        ],
    },
    {
        org: "Iliad Fellowship",
        role: "Research Fellow",
        date: "Apr 2026",
        loc: "London, UK",
        points: [
            "Intensive AI-safety research program: singular learning theory, developmental interpretability, decision theory and agent foundations.",
        ],
    },
    {
        org: "Stanford Center for AI Safety",
        role: "Research Collaborator",
        date: "2024 — present",
        loc: "Remote / Stanford, CA",
        points: [
            "Awarded ≈$25,000 grant for technical AI governance research; built interactive tools that let policymakers and executives engage with ML fundamentals.",
        ],
    },
    {
        org: "RWTH Aachen — Computer Vision Lab (Prof. Leibe)",
        role: "Student Researcher",
        date: "2025 — Apr 2026",
        loc: "Aachen, DE",
        points: [
            "Only undergraduate researcher in the lab; transformer-based human pose estimation and out-of-distribution evaluation pipelines.",
        ],
    },
    {
        org: "RWTH Aachen — Process & Data Science (Prof. Wil van der Aalst)",
        role: "Research Assistant",
        date: "2024",
        loc: "Aachen, DE",
        points: [
            "First-author work on generalized sequence alignment for event data with ambiguous timestamps, shipped as a C-accelerated Python library.",
        ],
    },
    {
        org: "Mealscanner",
        role: "Founder & Lead Developer",
        date: "2023 — 2024",
        loc: "Aachen, DE",
        points: [
            "Food-tech startup estimating nutrients and food sensitivities from photos; built the largest known dataset of its type (8,000+ meals).",
            "Funded by the NRW Founders Scholarship; received a tech-exit offer — declined it to pivot into technical AI governance research.",
        ],
    },
];

const publications = [
    ["2026", "Fingerprinting All AI Cluster I/O Without Mutually Trusted Processors", "Apart Research", "/blog/ai-cluster-fingerprinting"],
    ["2025", "Creating a Market for AI Training Data Using Hardware-Based Verification", "Presented to EU digital-policy leaders", "https://copyright.felkru.com"],
    ["wip", "Capture-Resistant Reranking for Social Platforms", "CORDA P10, ETH Zürich — in progress", null],
];

const service = [
    "Founder & former chair, AI Safety Aachen e.V. — organized the StanfordxRWTH AI Safety Forum (€25k+ fundraised; speakers incl. Clark Barrett, Axel Voss, Holger Hoos)",
    "Program Committee, AIES 2026 (AAAI/ACM Conference on AI, Ethics, and Society)",
    "Mentor, SAIGE Spring 2026 AI-safety incubator (with Duncan Eddy, Stanford HAI)",
    "Meridian Cambridge Hardware Assurance Programme — accepted, Aug 2026",
    "Reverse Mentor, Digital8 — advising DAX executives on AI and digital transformation",
    "Co-moderator, Politische Diversität — cross-party panel discussions on AI and elections",
];

const awards = [
    "#1 — OpenMP/CUDA Optimization Challenge, RWTH (96-core nodes, 4× H100; won 2 of 3 problems outright)",
    "MINT-EC Certificate with Distinction (≈100 awarded nationally per year)",
    "NRW Founders Scholarship (Gründungsstipendium NRW)",
    "Best Newcomer, F1inSchools National Finals 2019",
];

const skills = [
    ["Hardware & systems", "CUDA & GPU programming, side-channel instrumentation, C/C++, Linux, networking (RDMA/HDR), 3D design & fabrication"],
    ["Machine learning", "PyTorch, JAX, transformers, RL (PPO/AlphaZero), dataset engineering, time-series transfer learning"],
    ["Governance & policy", "Compute governance, hardware-based verification, EU policy process (JURI), policy briefings for MEPs and executives"],
    ["Languages", "German (native), English (fluent — IELTS Academic 8.0)"],
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Krückel — Resume" description={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="resume">
        <SiteBackground />
        <nav class="r-nav no-print">
            <a href="/" class="mono">← felkru.com</a>
            <button class="btn-accent mono" onclick="window.print()">Save as PDF</button>
        </nav>

        <main class="sheet">
            <header class="r-head">
                <h1>Felix Krückel</h1>
                <p class="r-tag">Hardware-based AI verification · Compute governance · EU policy</p>
                <p class="mono r-meta">
                    <a href="mailto:hi@felkru.com">hi@felkru.com</a> ·
                    <a href="https://www.felkru.com">felkru.com</a> ·
                    <a href="https://url.felkru.com/meet">url.felkru.com/meet</a> ·
                    Aachen, DE → Berkeley, CA (Jul 2026)
                </p>
            </header>

            <section>
                <h2 class="mono">Experience &amp; fellowships</h2>
                {
                    experience.map((e) => (
                        <article class="r-item">
                            <div class="r-row">
                                <h3>{e.org}</h3>
                                <span class="mono r-date">{e.date}</span>
                            </div>
                            <p class="r-role">{e.role} · {e.loc}</p>
                            <ul>
                                {e.points.map((p) => <li>{p}</li>)}
                            </ul>
                        </article>
                    ))
                }
            </section>

            <section>
                <h2 class="mono">Publications</h2>
                {
                    publications.map(([date, title, venue, href]) => (
                        <article class="r-item slim">
                            <div class="r-row">
                                <h3>{href ? <a href={href}>{title}</a> : title}</h3>
                                <span class="mono r-date">{date}</span>
                            </div>
                            <p class="r-role">{venue}</p>
                        </article>
                    ))
                }
            </section>

            <section>
                <h2 class="mono">Education</h2>
                <article class="r-item">
                    <div class="r-row">
                        <h3>B.Sc. Informatics — RWTH Aachen University</h3>
                        <span class="mono r-date">2024 — 2026</span>
                    </div>
                    <p class="r-role">Specialization: Machine Learning</p>
                    <ul>
                        <li>Accelerated track: degree in 4 semesters instead of the standard 6 — fastest 3% of the cohort; Master's-level courses alongside the Bachelor's.</li>
                        <li>Planned: BISP semester at UC Berkeley, then a Stanford-supervised thesis (2027).</li>
                    </ul>
                </article>
            </section>

            <section>
                <h2 class="mono">Service &amp; leadership</h2>
                <ul class="r-list">
                    {service.map((s) => <li>{s}</li>)}
                </ul>
            </section>

            <section>
                <h2 class="mono">Awards</h2>
                <ul class="r-list">
                    {awards.map((a) => <li>{a}</li>)}
                </ul>
            </section>

            <section>
                <h2 class="mono">Skills</h2>
                {
                    skills.map(([k, v]) => (
                        <p class="r-skill">
                            <strong>{k}:</strong> {v}
                        </p>
                    ))
                }
            </section>
        </main>

        <style>
            .resume {
                --bg: #0a0e14;
                --line: rgba(150, 170, 200, 0.16);
                --text: #e8edf5;
                --muted: #8b96a8;
                --teal: #5eead4;
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: "Space Grotesk", system-ui, sans-serif;
                -webkit-font-smoothing: antialiased;
            }
            .mono {
                font-family: "IBM Plex Mono", ui-monospace, monospace;
                font-size: 0.76rem;
                letter-spacing: 0.07em;
                text-transform: uppercase;
                color: var(--muted);
            }
            .r-nav, .sheet { position: relative; z-index: 1; }
            .r-nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                max-width: 880px;
                margin: 0 auto;
                padding: 1.2rem 1.4rem 0;
            }
            .r-nav a {
                color: var(--muted);
                text-decoration: none;
            }
            .r-nav a:hover { color: var(--teal); }
            .btn-accent {
                background: var(--teal);
                color: #06241d;
                border: none;
                padding: 0.6rem 1.1rem;
                border-radius: 6px;
                cursor: pointer;
                text-transform: uppercase;
            }
            .sheet {
                max-width: 880px;
                margin: 0 auto;
                padding: 2.5rem 1.4rem 4rem;
            }
            .r-head h1 {
                font-size: clamp(2.1rem, 5vw, 3rem);
                letter-spacing: -0.02em;
                margin: 0 0 0.4rem;
            }
            .r-tag {
                color: var(--teal);
                margin: 0 0 0.6rem;
                font-size: 1.05rem;
            }
            .r-meta { line-height: 1.9; }
            .r-meta a { color: var(--muted); }
            .r-meta a:hover { color: var(--teal); }
            section { margin-top: 2.6rem; }
            h2.mono {
                color: var(--teal);
                border-bottom: 1px solid var(--line);
                padding-bottom: 0.5rem;
                margin: 0 0 1.2rem;
            }
            .r-item { margin-bottom: 1.5rem; }
            .r-item.slim { margin-bottom: 1rem; }
            .r-row {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                align-items: baseline;
            }
            .r-item h3 {
                font-size: 1.05rem;
                font-weight: 600;
                margin: 0;
            }
            .r-item h3 a { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--line); }
            .r-item h3 a:hover { color: var(--teal); }
            .r-date { white-space: nowrap; }
            .r-role {
                color: var(--teal);
                font-size: 0.9rem;
                margin: 0.2rem 0 0.45rem;
            }
            .r-item ul, .r-list {
                margin: 0;
                padding-left: 1.15rem;
                color: var(--muted);
                font-size: 0.92rem;
                line-height: 1.6;
            }
            .r-list li { margin-bottom: 0.45rem; }
            .r-skill {
                color: var(--muted);
                font-size: 0.92rem;
                line-height: 1.6;
                margin: 0 0 0.55rem;
            }
            .r-skill strong { color: var(--text); font-weight: 600; }

            @media print {
                @page { margin: 14mm; }
                html, body, .resume {
                    background: #fff !important;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                .resume {
                    color: #111;
                    --text: #111;
                    --muted: #444;
                    --teal: #0e7a63;
                    --line: #ccc;
                }
                .no-print { display: none !important; }
                .sheet { padding: 0 !important; max-width: none; }
                section { margin-top: 1.3rem; break-inside: avoid; }
                h2.mono { break-after: avoid; }
                .r-item, .r-list li { break-inside: avoid; }
                a { color: inherit !important; }
            }
        </style>
    </body>
</html>
