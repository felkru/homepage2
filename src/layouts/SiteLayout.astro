---
import BaseHead from "../components/BaseHead.astro";
import SiteBackground from "../components/SiteBackground.astro";

const {
    title = import.meta.env.PUBLIC_TITLE,
    description = import.meta.env.PUBLIC_DESCRIPTION,
    image = "/social_img.jpeg",
    active = "",
    wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={image} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>document.documentElement.classList.add("js");</script>
    </head>
    <body class="site">
        <SiteBackground />
        <nav id="nav">
            <a class="brand" href="/">
                <span class="brand-mark">FK</span>
                <span class="brand-name">Felix Krückel</span>
            </a>
            <div class="nav-links">
                <a href="/#research" class:list={[active === "research" && "current"]}>Research</a>
                <a href="/blog" class:list={[active === "writing" && "current"]}>Writing</a>
                <a href="/#background" class:list={[active === "background" && "current"]}>Background</a>
                <a href="/contact" class:list={[active === "contact" && "current"]}>Contact</a>
            </div>
            <a class="btn-accent nav-cta" href="https://url.felkru.com/meet" target="_blank" rel="noopener">Book a call</a>
        </nav>

        <main class:list={["site-main", wide && "wide"]}>
            <slot />
        </main>

        <footer class="site-footer mono">
            <span>© 2026 Felix Krückel</span>
            <span class="foot-links">
                <a href="/blog">writing</a>
                <a href="/resume">resume</a>
                <a href="/rss.xml">rss</a>
            </span>
        </footer>

        <style is:global>
            .site {
                --bg: #0a0e14;
                --panel: #0f1520;
                --line: rgba(150, 170, 200, 0.14);
                --line-strong: rgba(150, 170, 200, 0.3);
                --text: #e8edf5;
                --muted: #8b96a8;
                --teal: #5eead4;
                --ice: #7dd3fc;
                --amber: #f5a623;
                --font-display: "Space Grotesk", system-ui, sans-serif;
                --font-mono: "IBM Plex Mono", ui-monospace, monospace;
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: var(--font-display);
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }
            .site ::selection {
                background: var(--teal);
                color: #06241d;
            }
            .site .mono {
                font-family: var(--font-mono);
                font-size: 0.78rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--muted);
            }

            /* ---------- nav ---------- */
            .site #nav {
                position: fixed;
                inset: 0 0 auto 0;
                z-index: 50;
                display: flex;
                align-items: center;
                gap: 2rem;
                padding: 0.9rem clamp(1.2rem, 4vw, 3rem);
                background: rgba(10, 14, 20, 0.82);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--line);
            }
            .site .brand {
                display: flex;
                align-items: center;
                gap: 0.7rem;
                text-decoration: none;
                color: var(--text);
                margin-right: auto;
            }
            .site .brand-mark {
                font-family: var(--font-mono);
                font-weight: 500;
                font-size: 0.85rem;
                color: var(--teal);
                border: 1px solid var(--line-strong);
                padding: 0.28rem 0.45rem;
                border-radius: 4px;
            }
            .site .brand-name {
                font-weight: 600;
                letter-spacing: 0.01em;
            }
            .site .nav-links {
                display: flex;
                gap: 1.6rem;
            }
            .site .nav-links a {
                color: var(--muted);
                text-decoration: none;
                font-size: 0.92rem;
                transition: color 0.2s;
            }
            .site .nav-links a:hover,
            .site .nav-links a.current {
                color: var(--text);
            }
            .site .nav-links a.current {
                color: var(--teal);
            }

            .site .btn-accent,
            .site .btn-ghost {
                font-family: var(--font-mono);
                font-size: 0.8rem;
                letter-spacing: 0.04em;
                text-decoration: none;
                padding: 0.62rem 1.15rem;
                border-radius: 6px;
                transition: transform 0.15s, background 0.2s, color 0.2s, border-color 0.2s;
                white-space: nowrap;
                cursor: pointer;
                display: inline-block;
            }
            .site .btn-accent {
                background: var(--teal);
                color: #06241d;
                font-weight: 500;
                border: none;
            }
            .site .btn-accent:hover {
                transform: translateY(-2px);
                background: #8ef2e0;
            }
            .site .btn-ghost {
                color: var(--text);
                border: 1px solid var(--line-strong);
                background: none;
            }
            .site .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal);
            }

            /* ---------- main shell ---------- */
            .site #nav,
            .site-main,
            .site-footer {
                position: relative;
                z-index: 1;
            }
            .site-main {
                max-width: 820px;
                margin: 0 auto;
                padding: clamp(6rem, 12vw, 9rem) clamp(1.2rem, 5vw, 3rem) 4rem;
                min-height: 60vh;
            }
            .site-main.wide {
                max-width: 1200px;
            }

            /* shared section header (mono index + title + hairline) */
            .site .page-head {
                display: flex;
                align-items: baseline;
                gap: 1.1rem;
                margin-bottom: clamp(1.5rem, 4vw, 2.6rem);
            }
            .site .page-head .index {
                color: var(--teal);
            }
            .site .page-head h1 {
                font-size: clamp(2rem, 5vw, 3.2rem);
                font-weight: 700;
                letter-spacing: -0.025em;
                margin: 0;
            }
            .site .rule {
                flex: 1;
                height: 1px;
                background: var(--line);
                transform-origin: left;
            }
            .site .lede {
                font-size: clamp(1.05rem, 2vw, 1.35rem);
                line-height: 1.55;
                max-width: 52ch;
                color: #c3ccda;
                margin: 0 0 clamp(2rem, 4vw, 3rem);
            }
            .site .lede em {
                font-style: normal;
                color: var(--teal);
            }

            /* ---------- footer ---------- */
            .site-footer {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
                max-width: 1200px;
                margin: 0 auto;
                padding: 1.6rem clamp(1.2rem, 5vw, 4rem) 2.2rem;
                border-top: 1px solid var(--line);
            }
            .site .foot-links {
                display: flex;
                gap: 1.4rem;
            }
            .site-footer a {
                color: var(--muted);
                text-decoration: none;
            }
            .site-footer a:hover {
                color: var(--teal);
            }

            /* ---------- prose (rendered MDX) ---------- */
            .prose {
                font-size: 1.05rem;
                line-height: 1.72;
                color: #cdd5e1;
            }
            .prose > * + * {
                margin-top: 1.15rem;
            }
            .prose h1,
            .prose h2,
            .prose h3,
            .prose h4 {
                color: var(--text);
                font-weight: 600;
                letter-spacing: -0.015em;
                line-height: 1.25;
                margin-top: 2.4rem;
                margin-bottom: 0.2rem;
                scroll-margin-top: 6rem;
            }
            .prose h2 {
                font-size: 1.7rem;
                padding-bottom: 0.4rem;
                border-bottom: 1px solid var(--line);
            }
            .prose h3 {
                font-size: 1.3rem;
            }
            .prose h4 {
                font-size: 1.1rem;
            }
            .prose a {
                color: var(--teal);
                text-decoration: none;
                border-bottom: 1px solid rgba(94, 234, 212, 0.35);
                transition: border-color 0.2s;
            }
            .prose a:hover {
                border-bottom-color: var(--teal);
            }
            .prose strong {
                color: var(--text);
                font-weight: 600;
            }
            .prose ul,
            .prose ol {
                padding-left: 1.4rem;
            }
            .prose li {
                margin-top: 0.35rem;
            }
            .prose li::marker {
                color: var(--teal);
            }
            .prose blockquote {
                border-left: 2px solid var(--teal);
                padding-left: 1.1rem;
                margin-left: 0;
                color: var(--muted);
                font-style: italic;
            }
            .prose code {
                font-family: var(--font-mono);
                font-size: 0.86em;
                background: var(--panel);
                border: 1px solid var(--line);
                border-radius: 4px;
                padding: 0.1em 0.4em;
            }
            .prose pre {
                background: #0c121c;
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 1rem 1.2rem;
                overflow-x: auto;
                font-size: 0.85rem;
            }
            .prose pre code {
                background: none;
                border: none;
                padding: 0;
                font-size: inherit;
            }
            .prose img {
                border-radius: 8px;
                border: 1px solid var(--line);
                margin-left: auto;
                margin-right: auto;
            }
            .prose hr {
                border: none;
                border-top: 1px solid var(--line);
                margin: 2.2rem 0;
            }
            .prose table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.92rem;
                display: block;
                overflow-x: auto;
            }
            .prose th,
            .prose td {
                border: 1px solid var(--line);
                padding: 0.5rem 0.8rem;
                text-align: left;
            }
            .prose th {
                background: var(--panel);
                color: var(--text);
                font-family: var(--font-mono);
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            .prose .katex-display {
                overflow-x: auto;
                overflow-y: hidden;
                padding: 0.4rem 0;
            }
            /* rehype-toc table of contents */
            .prose .toc-post {
                background: var(--panel);
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 1rem 1.3rem;
                font-size: 0.92rem;
            }
            .prose .toc-post ol {
                padding-left: 1.1rem;
            }
            .prose .toc-link {
                color: var(--muted);
            }
            .prose .toc-link:hover {
                color: var(--teal);
            }

            /* reveal initial state (JS clears) */
            .js .site [data-reveal] {
                opacity: 0;
                transform: translateY(24px);
            }

            @media (max-width: 760px) {
                .site .nav-links {
                    display: none;
                }
                .site .brand-name {
                    display: none;
                }
            }
            @media (prefers-reduced-motion: reduce) {
                .js .site [data-reveal] {
                    opacity: 1 !important;
                    transform: none !important;
                }
            }
        </style>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!reduced) {
                gsap.registerPlugin(ScrollTrigger);
                gsap.utils.toArray("[data-reveal]").forEach((el) => {
                    gsap.to(el, {
                        opacity: 1,
                        y: 0,
                        duration: 0.85,
                        ease: "power3.out",
                        scrollTrigger: { trigger: el, start: "top 90%" },
                    });
                });
                gsap.utils.toArray(".rule").forEach((el) => {
                    gsap.from(el, {
                        scaleX: 0,
                        duration: 1.1,
                        ease: "power3.inOut",
                        scrollTrigger: { trigger: el, start: "top 92%" },
                    });
                });
            }
        </script>
    </body>
</html>
