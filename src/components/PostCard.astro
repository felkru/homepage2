---
import { Image } from "astro:assets";
const { title, img, desc, url, target = "_self", tags = [], badge } = Astro.props;
---

<a class="post-card" href={url} target={target} data-reveal>
    {
        img && (
            <div class="post-img">
                <Image src={img} alt={title} widths={[480, 720]} sizes="(max-width: 700px) 95vw, 380px" />
            </div>
        )
    }
    <div class="post-body">
        <h3>
            {title}
            {badge && <span class="post-badge mono">{badge}</span>}
        </h3>
        <p>{desc}</p>
        {
            tags && tags.length > 0 && (
                <div class="post-tags">
                    {tags.slice(0, 3).map((t) => (
                        <span class="post-tag mono">{t}</span>
                    ))}
                </div>
            )
        }
    </div>
</a>

<style>
    .post-card {
        text-decoration: none;
        color: var(--text, #e8edf5);
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line, rgba(150, 170, 200, 0.14));
        border-radius: 10px;
        overflow: hidden;
        background: var(--panel, #0f1520);
        transition: border-color 0.25s, transform 0.25s;
    }
    .post-card:hover {
        border-color: var(--teal, #5eead4);
        transform: translateY(-3px);
    }
    .post-img {
        overflow: hidden;
        border-bottom: 1px solid var(--line, rgba(150, 170, 200, 0.14));
    }
    .post-img :global(img) {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
        transition: transform 0.45s cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    .post-card:hover .post-img :global(img) {
        transform: scale(1.04);
    }
    .post-body {
        padding: 1.1rem 1.2rem 1.3rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .post-card h3 {
        font-size: 1.08rem;
        font-weight: 600;
        margin: 0 0 0.4rem;
        line-height: 1.3;
    }
    .post-card:hover h3 {
        color: var(--teal, #5eead4);
    }
    .post-badge {
        color: var(--amber, #f5a623);
        margin-left: 0.4rem;
        font-size: 0.66rem;
    }
    .post-card p {
        color: var(--muted, #8b96a8);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 0 0 0.9rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
    }
    .post-tag {
        font-size: 0.62rem;
        color: var(--muted, #8b96a8);
        border: 1px solid var(--line, rgba(150, 170, 200, 0.14));
        border-radius: 4px;
        padding: 0.18rem 0.45rem;
    }
</style>
