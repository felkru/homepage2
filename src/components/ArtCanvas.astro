---
// Lightweight canvas-2D generative art, same palette/feel as the blog thumbnails.
// variant: "flow" | "constellation" | "nbody". Mouse-interactive, pauses offscreen,
// respects prefers-reduced-motion (renders a single static frame).
const { variant = "flow", seed = 1, height = "340px", class: className = "" } = Astro.props;
const canvasId = "art-" + Math.random().toString(36).slice(2, 9);
---

<div class:list={["art-wrap", className]} style={`height:${height}`}>
    <canvas id={canvasId}></canvas>
</div>

<style>
    .art-wrap {
        position: relative;
        width: 100%;
        overflow: hidden;
    }
    .art-wrap canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

<script is:inline define:vars={{ canvasId, variant, seed }}>
    (() => {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const TEAL = "94,234,212", ICE = "125,211,252", AMBER = "245,166,35", VIOLET = "167,139,250";
        let W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);

        // seeded PRNG
        let s = (seed * 9301 + 49297) % 233280;
        const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };

        const mouse = { x: -999, y: -999, on: false };

        function resize() {
            const r = canvas.getBoundingClientRect();
            W = r.width; H = r.height;
            canvas.width = Math.max(1, W * dpr);
            canvas.height = Math.max(1, H * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        // ---------------- flow field (persistent streamers) ----------------
        function makeFlow() {
            const N = Math.min(150, Math.max(40, Math.floor(W / 9)));
            const spawn = (p) => {
                p = p || {};
                p.x = rnd() * W; p.y = rnd() * H; p.trail = [];
                p.life = 80 + rnd() * 160;
                p.c = rnd() < 0.85 ? (rnd() < 0.5 ? TEAL : ICE) : AMBER;
                return p;
            };
            const pts = Array.from({ length: N }, () => spawn());
            const ang = (x, y, t) =>
                Math.sin(x * 0.004 + t * 0.0002) * 2.1 +
                Math.cos(y * 0.006 - t * 0.00015) * 1.7 +
                Math.sin((x + y) * 0.002) * 1.3;
            return {
                step(t) {
                    ctx.clearRect(0, 0, W, H);
                    for (const p of pts) {
                        let a = ang(p.x, p.y, t);
                        if (mouse.on) {
                            const dx = p.x - mouse.x, dy = p.y - mouse.y;
                            const d2 = dx * dx + dy * dy;
                            if (d2 < 30000) a += Math.atan2(dy, dx) * (1 - d2 / 30000) * 2.6;
                        }
                        p.x += Math.cos(a) * 1.3;
                        p.y += Math.sin(a) * 1.3;
                        p.trail.push([p.x, p.y]);
                        if (p.trail.length > 24) p.trail.shift();
                        p.life--;
                        for (let i = 1; i < p.trail.length; i++) {
                            const al = (i / p.trail.length) * 0.6;
                            ctx.strokeStyle = `rgba(${p.c},${al})`;
                            ctx.lineWidth = 1.1;
                            ctx.beginPath();
                            ctx.moveTo(p.trail[i - 1][0], p.trail[i - 1][1]);
                            ctx.lineTo(p.trail[i][0], p.trail[i][1]);
                            ctx.stroke();
                        }
                        if (p.life < 0 || p.x < -12 || p.x > W + 12 || p.y < -12 || p.y > H + 12) spawn(p);
                    }
                },
                clear() { ctx.clearRect(0, 0, W, H); },
            };
        }

        // ---------------- constellation ----------------
        function makeConstellation() {
            const N = Math.min(70, Math.floor(W / 16));
            const nodes = Array.from({ length: N }, () => ({
                x: rnd() * W, y: rnd() * H,
                vx: (rnd() - 0.5) * 0.3, vy: (rnd() - 0.5) * 0.3,
                c: rnd() < 0.9 ? (rnd() < 0.5 ? TEAL : ICE) : AMBER,
            }));
            const LINK = 130;
            return {
                step() {
                    ctx.clearRect(0, 0, W, H);
                    for (const n of nodes) {
                        n.x += n.vx; n.y += n.vy;
                        if (n.x < 0 || n.x > W) n.vx *= -1;
                        if (n.y < 0 || n.y > H) n.vy *= -1;
                        if (mouse.on) {
                            const dx = mouse.x - n.x, dy = mouse.y - n.y;
                            const d2 = dx * dx + dy * dy;
                            if (d2 < 30000 && d2 > 1) { n.vx += dx / d2 * 6; n.vy += dy / d2 * 6; }
                        }
                        n.vx = Math.max(-1.2, Math.min(1.2, n.vx));
                        n.vy = Math.max(-1.2, Math.min(1.2, n.vy));
                    }
                    for (let i = 0; i < N; i++) {
                        for (let j = i + 1; j < N; j++) {
                            const a = nodes[i], b = nodes[j];
                            const d = Math.hypot(a.x - b.x, a.y - b.y);
                            if (d < LINK) {
                                ctx.strokeStyle = `rgba(${a.c},${0.22 * (1 - d / LINK)})`;
                                ctx.lineWidth = 1;
                                ctx.beginPath();
                                ctx.moveTo(a.x, a.y);
                                ctx.lineTo(b.x, b.y);
                                ctx.stroke();
                            }
                        }
                    }
                    for (const n of nodes) {
                        ctx.fillStyle = `rgba(${n.c},0.9)`;
                        ctx.beginPath();
                        ctx.arc(n.x, n.y, 1.8, 0, 7);
                        ctx.fill();
                    }
                },
                clear() { ctx.clearRect(0, 0, W, H); },
            };
        }

        // ---------------- n-body ----------------
        function makeNbody() {
            const cx = () => W / 2, cy = () => H / 2;
            const bodies = [];
            const cols = [TEAL, ICE, VIOLET, TEAL, AMBER, ICE];
            for (let i = 0; i < 6; i++) {
                const ang = rnd() * Math.PI * 2, r = 60 + i * 26 + rnd() * 16;
                const v = Math.sqrt(90000 / r) * (0.85 + rnd() * 0.25);
                bodies.push({
                    x: cx() + Math.cos(ang) * r, y: cy() + Math.sin(ang) * r,
                    vx: -Math.sin(ang) * v * 0.016, vy: Math.cos(ang) * v * 0.016,
                    m: 0.8 + rnd() * 2, c: cols[i], trail: [],
                });
            }
            return {
                step() {
                    ctx.fillStyle = "rgba(10,14,20,0.14)";
                    ctx.fillRect(0, 0, W, H);
                    const MU = 90000;
                    for (const b of bodies) {
                        let dx = cx() - b.x, dy = cy() - b.y;
                        let d2 = dx * dx + dy * dy + 200;
                        let f = MU / (d2 * Math.sqrt(d2));
                        let ax = dx * f, ay = dy * f;
                        if (mouse.on) {
                            dx = mouse.x - b.x; dy = mouse.y - b.y;
                            d2 = dx * dx + dy * dy + 400;
                            f = 60000 / (d2 * Math.sqrt(d2));
                            ax += dx * f; ay += dy * f;
                        }
                        b.vx += ax; b.vy += ay;
                        b.x += b.vx; b.y += b.vy;
                        b.trail.push([b.x, b.y]);
                        if (b.trail.length > 26) b.trail.shift();
                        ctx.strokeStyle = `rgba(${b.c},0.5)`;
                        ctx.lineWidth = 1.2;
                        ctx.beginPath();
                        b.trail.forEach(([x, y], i) => i ? ctx.lineTo(x, y) : ctx.moveTo(x, y));
                        ctx.stroke();
                        ctx.fillStyle = `rgba(${b.c},0.95)`;
                        ctx.beginPath();
                        ctx.arc(b.x, b.y, 1.6 + b.m, 0, 7);
                        ctx.fill();
                    }
                    ctx.fillStyle = `rgba(${AMBER},1)`;
                    ctx.beginPath();
                    ctx.arc(cx(), cy(), 4, 0, 7);
                    ctx.fill();
                },
                clear() { ctx.clearRect(0, 0, W, H); },
            };
        }

        let sim;
        function build() {
            resize();
            sim = variant === "constellation" ? makeConstellation()
                : variant === "nbody" ? makeNbody()
                : makeFlow();
        }

        canvas.addEventListener("pointermove", (e) => {
            const r = canvas.getBoundingClientRect();
            mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; mouse.on = true;
        });
        canvas.addEventListener("pointerleave", () => (mouse.on = false));

        let visible = true, started = false;
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);

        let rt;
        new ResizeObserver(() => {
            clearTimeout(rt);
            rt = setTimeout(() => { build(); if (reduced && started) renderStatic(); }, 150);
        }).observe(canvas);

        function renderStatic() { for (let i = 0; i < 220; i++) sim.step(i * 16); }

        // rAF is auto-paused by the browser while the tab is hidden, so the
        // animation naturally pauses/resumes; we only skip drawing when offscreen.
        function loop(t) {
            if (visible && !document.hidden) sim.step(t);
            requestAnimationFrame(loop);
        }

        // build after first frame so layout (and the canvas box) is settled.
        requestAnimationFrame(() => {
            build();
            started = true;
            if (reduced) renderStatic();
            else loop(performance.now());
        });
    })();
</script>
