---
// Very slow, dim, non-interactive flow field painted fixed behind all content.
// One instance per page. Pauses when tab hidden; static frame for reduced-motion.
---
<canvas id="site-bg" aria-hidden="true"></canvas>

<style>
    #site-bg {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
        opacity: 0.8;
    }
    @media print {
        #site-bg { display: none !important; }
    }
</style>

<script is:inline>
    (() => {
        const canvas = document.getElementById("site-bg");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const TEAL = "94,234,212", ICE = "125,211,252", AMBER = "245,166,35";
        let W = 0, H = 0, pts = [], built = false;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        let seed = 99;
        const rnd = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };

        function resize() {
            W = window.innerWidth; H = window.innerHeight;
            canvas.width = W * dpr; canvas.height = H * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        const spawn = (p) => {
            p = p || {};
            p.x = rnd() * W; p.y = rnd() * H; p.trail = [];
            p.life = 200 + rnd() * 300;
            p.c = rnd() < 0.88 ? (rnd() < 0.5 ? TEAL : ICE) : AMBER;
            return p;
        };
        function build() {
            resize();
            const N = Math.min(170, Math.max(60, Math.floor((W * H) / 11000)));
            pts = Array.from({ length: N }, () => spawn());
            built = true;
        }
        const ang = (x, y, t) =>
            Math.sin(x * 0.0016 + t * 0.00004) * 2.1 +
            Math.cos(y * 0.0021 - t * 0.00003) * 1.7 +
            Math.sin((x + y) * 0.0011) * 1.3;

        function step(t) {
            ctx.clearRect(0, 0, W, H);
            for (const p of pts) {
                const a = ang(p.x, p.y, t);
                p.x += Math.cos(a) * 0.55;   // slow drift
                p.y += Math.sin(a) * 0.55;
                p.trail.push([p.x, p.y]);
                if (p.trail.length > 50) p.trail.shift();
                p.life--;
                for (let i = 1; i < p.trail.length; i++) {
                    const al = (i / p.trail.length) * 0.5;
                    ctx.strokeStyle = `rgba(${p.c},${al})`;
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.moveTo(p.trail[i - 1][0], p.trail[i - 1][1]);
                    ctx.lineTo(p.trail[i][0], p.trail[i][1]);
                    ctx.stroke();
                }
                if (p.life < 0 || p.x < -20 || p.x > W + 20 || p.y < -20 || p.y > H + 20) spawn(p);
            }
        }

        window.addEventListener("resize", () => { if (built) build(); });

        function loop(t) {
            if (!document.hidden) step(t);
            requestAnimationFrame(loop);
        }
        requestAnimationFrame(() => {
            build();
            if (reduced) { for (let i = 0; i < 260; i++) step(i * 16); }
            else loop(performance.now());
        });
    })();
</script>
