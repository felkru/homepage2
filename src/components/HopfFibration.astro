---

---

<div id="hopf-container" class="not-prose hopf-ui-hidden">
  <header
    class="hopf-header absolute top-0 left-0 p-8 z-10 pointer-events-none transition-opacity duration-500"
  >
    <h1 class="text-3xl font-light tracking-[0.4em] text-white opacity-90">
      HYPER-FIBER
    </h1>
    <div
      class="h-[1px] w-32 bg-gradient-to-r from-indigo-500 to-transparent my-2"
    >
    </div>
    <p class="text-indigo-400 text-xs tracking-widest uppercase font-medium">
      Volumetric S³ Topology
    </p>
  </header>

  <main
    id="hopf-canvas-container"
    class="flex-grow relative overflow-hidden bg-[#000000]"
  >
    <canvas id="hopfCanvas"></canvas>
  </main>

  <div
    id="hopf-ui-panel"
    class="hopf-glass absolute top-4 right-4 p-6 rounded-2xl w-72 z-20"
  >
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-indigo-400 uppercase tracking-tighter"
              >Volume Shells</label
            >
            <span id="shellsVal" class="text-xs font-mono text-white/60">4</span
            >
          </div>
          <input
            type="range"
            id="shellsSlider"
            min="1"
            max="15"
            value="4"
            class="w-full"
          />
        </div>
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-cyan-400 uppercase tracking-tighter"
              >Fiber Density</label
            >
            <span id="densityVal" class="text-xs font-mono text-white/60"
              >24</span
            >
          </div>
          <input
            type="range"
            id="densitySlider"
            min="2"
            max="64"
            value="24"
            class="w-full"
          />
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-purple-400 uppercase tracking-tighter"
              >Flow Velocity</label
            >
            <span id="speedVal" class="text-xs font-mono text-white/60"
              >9.1</span
            >
          </div>
          <input
            type="range"
            id="speedSlider"
            min="0"
            max="15"
            step="0.1"
            value="9.1"
            class="w-full"
          />
        </div>
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-pink-400 uppercase tracking-tighter"
              >Camera Zoom</label
            >
            <span id="zoomVal" class="text-xs font-mono text-white/60">0.4</span
            >
          </div>
          <input
            type="range"
            id="zoomSlider"
            min="0.1"
            max="5"
            step="0.05"
            value="0.4"
            class="w-full"
          />
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-emerald-400 uppercase tracking-tighter"
              >Cycle Speed</label
            >
            <span id="hueSpeedVal" class="text-xs font-mono text-white/60"
              >1.0</span
            >
          </div>
          <input
            type="range"
            id="hueSpeedSlider"
            min="0"
            max="10"
            step="0.1"
            value="1.0"
            class="w-full"
          />
        </div>
        <div>
          <div class="flex justify-between items-center mb-1">
            <label
              class="text-[10px] font-bold text-orange-400 uppercase tracking-tighter"
              >Vertex Quality</label
            >
            <span id="pointsVal" class="text-xs font-mono text-white/60"
              >411</span
            >
          </div>
          <input
            type="range"
            id="pointsSlider"
            min="10"
            max="500"
            value="411"
            class="w-full"
          />
        </div>
      </div>

      <div class="flex flex-col gap-3 pt-4 border-t border-white/10">
        <button
          id="toggleAuto"
          class="hopf-btn-control w-full border-indigo-500/40 text-indigo-300"
        >
          Rotation: <span id="autoStatus">Auto</span>
        </button>
        <button
          id="btnReset"
          class="hopf-btn-control w-full border-red-500/20 text-red-400/80"
        >
          Reset View
        </button>
      </div>
    </div>
  </div>

  <!-- Fullscreen button -->
  <button
    id="hopf-fullscreen"
    class="hopf-fullscreen-btn"
    title="Toggle fullscreen"
  >
    <svg
      id="hopf-fs-icon-expand"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
    <svg
      id="hopf-fs-icon-collapse"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      style="display:none"
    >
      <polyline points="4 14 10 14 10 20"></polyline>
      <polyline points="20 10 14 10 14 4"></polyline>
      <line x1="14" y1="10" x2="21" y2="3"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </button>

  <!-- Hint -->
  <div id="hopf-hint" class="hopf-hint">
    Press <kbd>H</kbd> for controls · Click & drag to rotate
  </div>
</div>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500&display=swap");

  #hopf-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 1rem;
    overflow: hidden;
    cursor: crosshair;
    background: #000000;
    margin: 1.5rem 0;
    font-family: "Space Grotesk", sans-serif;
    color: #e0e0e0;
    display: flex;
    flex-direction: column;
  }

  #hopf-container:fullscreen {
    aspect-ratio: unset;
    border-radius: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
  }

  .hopf-glass {
    background: rgba(8, 8, 12, 0.9);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.9);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .hopf-ui-hidden .hopf-glass,
  .hopf-ui-hidden .hopf-header,
  .hopf-ui-hidden .hopf-hint {
    opacity: 0 !important;
    pointer-events: none;
    transform: translateY(20px);
  }

  #hopfCanvas {
    touch-action: none;
    cursor: crosshair;
    display: block;
    width: 100%;
    height: 100%;
  }

  input[type="range"] {
    appearance: none;
    height: 4px;
    background: #1a1a2e;
    border-radius: 2px;
  }

  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 14px;
    height: 14px;
    background: #818cf8;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(129, 140, 248, 0.6);
  }

  .hopf-btn-control {
    @apply py-2 px-3 rounded-xl border border-white/10 text-[9px] uppercase font-bold tracking-widest hover:bg-white/5 transition-all active:scale-95;
    background: transparent;
  }

  .hopf-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    color: rgba(129, 140, 248, 0.45);
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    transition: opacity 0.4s ease;
  }

  .hopf-hint kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    padding: 0 4px;
    font-size: 0.6rem;
  }

  .hopf-fullscreen-btn {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    z-index: 30;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: rgba(129, 140, 248, 0.6);
    padding: 6px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
  .hopf-fullscreen-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(129, 140, 248, 0.9);
  }
</style>

<script is:inline>
  (function () {
    const container = document.getElementById("hopf-container");
    const canvas = document.getElementById("hopfCanvas");
    const ctx = canvas.getContext("2d", { alpha: false, desynchronized: true });
    const canvasContainer = document.getElementById("hopf-canvas-container");

    const settings = {
      shellCount: 4,
      fiberDensity: 24,
      flowSpeed: 9.1,
      zoom: 0.4,
      hueOffset: 0,
      hueCycleSpeed: 1.0,
      pointsPerFiber: 411,
      autoRotate: true,
    };

    let width, height, dpr;
    let rotationX = 0.5,
      rotationY = 0.3;
    let velX = 0.002,
      velY = 0.005;
    let isDragging = false;
    let lastMousePos = { x: 0, y: 0 };
    let time = 0;
    let uiVisible = false;

    // Object Pool
    const pointPool = [];
    function getPoint() {
      return pointPool.length > 0
        ? pointPool.pop()
        : { x: 0, y: 0, z: 0, p: 0 };
    }
    function releasePoints(arr) {
      for (let i = 0; i < arr.length; i++) pointPool.push(arr[i]);
      arr.length = 0;
    }

    function resizeCanvas() {
      if (!canvasContainer) return;
      width = canvasContainer.clientWidth;
      height = canvasContainer.clientHeight;
      dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Resize handling
    let resizeTimeout;
    new ResizeObserver(() => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        resizeCanvas();
      }, 50);
    }).observe(container);

    const bind = (id, valId, prop, suffix = "") => {
      const el = document.getElementById(id);
      el.oninput = (e) => {
        const v = parseFloat(e.target.value);
        settings[prop] = v;
        document.getElementById(valId).innerText = v + suffix;
      };
    };
    bind("shellsSlider", "shellsVal", "shellCount");
    bind("densitySlider", "densityVal", "fiberDensity");
    bind("speedSlider", "speedVal", "flowSpeed");
    bind("zoomSlider", "zoomVal", "zoom");
    bind("hueSpeedSlider", "hueSpeedVal", "hueCycleSpeed");
    bind("pointsSlider", "pointsVal", "pointsPerFiber");

    document.getElementById("toggleAuto").onclick = () => {
      settings.autoRotate = !settings.autoRotate;
      document.getElementById("autoStatus").innerText = settings.autoRotate
        ? "Auto"
        : "Manual";
    };

    document.getElementById("btnReset").onclick = () => {
      rotationX = 0.5;
      rotationY = 0.3;
      velX = 0.002;
      velY = 0.005;
      settings.zoom = 0.4;
      document.getElementById("zoomSlider").value = 0.4;
      document.getElementById("zoomVal").innerText = "0.4";
    };

    // Fullscreen handling
    const fsBtn = document.getElementById("hopf-fullscreen");
    const fsIconExpand = document.getElementById("hopf-fs-icon-expand");
    const fsIconCollapse = document.getElementById("hopf-fs-icon-collapse");

    fsBtn.onclick = () => {
      if (!document.fullscreenElement) {
        container.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen();
      }
    };

    document.addEventListener("fullscreenchange", () => {
      const isFs = document.fullscreenElement === container;
      fsIconExpand.style.display = isFs ? "none" : "block";
      fsIconCollapse.style.display = isFs ? "block" : "none";

      requestAnimationFrame(() => {
        resizeCanvas();
      });
    });

    // Keyboard controls
    window.addEventListener("keydown", (e) => {
      if (e.key.toLowerCase() === "h") {
        uiVisible = !uiVisible;
        container.classList.toggle("hopf-ui-hidden", !uiVisible);
      }
    });

    // Mouse interaction
    canvas.addEventListener("mousedown", (e) => {
      isDragging = true;
      lastMousePos = { x: e.clientX, y: e.clientY };
    });
    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastMousePos.x;
      const dy = e.clientY - lastMousePos.y;
      velX = dx * 0.005;
      velY = dy * 0.005;
      rotationX += velX;
      rotationY += velY;
      lastMousePos = { x: e.clientX, y: e.clientY };
    });
    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    // Touch interaction
    canvas.addEventListener(
      "touchstart",
      (e) => {
        isDragging = true;
        lastMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      },
      { passive: false },
    );
    canvas.addEventListener(
      "touchmove",
      (e) => {
        if (!isDragging) return;
        const dx = e.touches[0].clientX - lastMousePos.x;
        const dy = e.touches[0].clientY - lastMousePos.y;
        velX = dx * 0.005;
        velY = dy * 0.005;
        rotationX += velX;
        rotationY += velY;
        lastMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      },
      { passive: false },
    );
    canvas.addEventListener("touchend", () => {
      isDragging = false;
    });

    const fibers = [];
    function render() {
      ctx.globalCompositeOperation = "source-over";
      ctx.fillStyle = "#000000";
      ctx.fillRect(0, 0, width, height);

      time += 0.01 * settings.flowSpeed;
      if (settings.hueCycleSpeed > 0)
        settings.hueOffset =
          (settings.hueOffset + settings.hueCycleSpeed * 0.5) % 360;

      if (settings.autoRotate && !isDragging) {
        velX += (0.001 - velX) * 0.05;
        velY += (0.003 - velY) * 0.05;
      } else if (!isDragging) {
        velX *= 0.98;
        velY *= 0.98;
      }
      rotationX += velX;
      rotationY += velY;

      const cosX = Math.cos(rotationX),
        sinX = Math.sin(rotationX);
      const cosY = Math.cos(rotationY),
        sinY = Math.sin(rotationY);
      const baseScale = Math.min(width, height) * 0.35 * settings.zoom;
      const midW = width / 2,
        midH = height / 2;

      fibers.forEach((f) => releasePoints(f.points));
      fibers.length = 0;

      for (let s = 1; s <= settings.shellCount; s++) {
        const theta = (s / (settings.shellCount + 1)) * Math.PI * 0.5;
        const sinT = Math.sin(theta),
          cosT = Math.cos(theta);
        for (let i = 0; i < settings.fiberDensity; i++) {
          const phi = (i / settings.fiberDensity) * Math.PI * 2;
          const pts = [];
          for (let j = 0; j <= settings.pointsPerFiber; j++) {
            const psi = (j / settings.pointsPerFiber) * Math.PI * 2;
            const x1 = cosT * Math.cos(psi),
              x2 = cosT * Math.sin(psi);
            const x3 = sinT * Math.cos(phi + psi),
              x4 = sinT * Math.sin(phi + psi);
            const f = 1 / (1.1 - x4);
            const r_x1 = x1 * f * cosY + x3 * f * sinY;
            const r_z1 = x3 * f * cosY - x1 * f * sinY;
            const r_y2 = x2 * f * cosX - r_z1 * sinX;
            const r_z2 = r_z1 * cosX + x2 * f * sinX;
            const p = 800 / (800 + r_z2 * baseScale);
            const pt = getPoint();
            pt.x = midW + r_x1 * baseScale * p;
            pt.y = midH + r_y2 * baseScale * p;
            pt.z = r_z2;
            pt.p = p;
            pts.push(pt);
          }
          fibers.push({
            points: pts,
            z: pts[0].z,
            color: (phi * 180) / Math.PI + s * 30,
            shell: s,
          });
        }
      }

      fibers.sort((a, b) => b.z - a.z);
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      for (let k = 0; k < fibers.length; k++) {
        const f = fibers[k];
        const zAlpha = Math.min(1, Math.max(0.1, (f.z + 3) / 6));
        const thickness = 1.4 * f.points[0].p * (f.shell / settings.shellCount);
        const hue = (f.color + settings.hueOffset) % 360;
        const hsla = `hsla(${hue}, 85%, 60%`;
        ctx.beginPath();
        ctx.moveTo(f.points[0].x, f.points[0].y);
        for (let i = 1; i < f.points.length; i++)
          ctx.lineTo(f.points[i].x, f.points[i].y);
        ctx.globalCompositeOperation = "lighter";
        ctx.strokeStyle = `${hsla}, ${zAlpha * 0.15})`;
        ctx.lineWidth = thickness * 5;
        ctx.stroke();
        ctx.globalCompositeOperation = "source-over";
        ctx.strokeStyle = `${hsla}, ${zAlpha * 0.9})`;
        ctx.lineWidth = thickness;
        ctx.stroke();
        if (settings.flowSpeed > 0 && f.points.length > 1) {
          const pIdx = Math.floor((time * 30) % f.points.length);
          const p = f.points[pIdx % f.points.length];
          ctx.globalCompositeOperation = "lighter";
          ctx.fillStyle = "#fff";
          ctx.beginPath();
          ctx.arc(p.x, p.y, thickness * 1.8, 0, 6.28);
          ctx.fill();
          ctx.fillStyle = `${hsla}, 0.75)`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, thickness * 10, 0, 6.28);
          ctx.fill();
        }
      }
      requestAnimationFrame(render);
    }

    // Initial resize
    resizeCanvas();
    render();
  })();
</script>
