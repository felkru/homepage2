---
const { number_of_pages, url, ...rest } = Astro.props;
---

<iframe
    class:list={["w-full", "md:w-[90vw]", "lg:w-[65vw]", "max-w-[810px]", "aspect-" + number_of_pages + "xA4"]}
    src={url}
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
    {...rest}
    >Reload the page or use another browser to view my resume...</iframe
>
<div class={`aspect-${number_of_pages}xA4 hidden`}></div>