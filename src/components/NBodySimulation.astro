---

---

<div id="nbody-container" class="not-prose">
  <canvas id="nbody-canvas"></canvas>

  <!-- UI Overlay -->
  <div id="nbody-ui" class="nbody-ui-panel nbody-controls nbody-ui-hidden">
    <h2 class="nbody-title">N-Body Engine v5.0</h2>
    <p class="nbody-subtitle">Cosmic Blueprints</p>

    <!-- Initialization Tabs -->
    <div class="nbody-tabs">
      <button id="tab-disk" class="nbody-tab tab-active">DISK</button>
      <button id="tab-binary" class="nbody-tab tab-inactive">BINARY</button>
      <button id="tab-grid" class="nbody-tab tab-inactive">GRID</button>
      <button id="tab-chaos" class="nbody-tab tab-inactive">CHAOS</button>
    </div>

    <div class="nbody-sliders">
      <div class="nbody-slider-group">
        <div class="nbody-slider-label">
          <span>Particle Count</span><span id="nbody-count-val">800</span>
        </div>
        <input
          type="range"
          id="nbody-particle-count"
          min="10"
          max="1500"
          value="800"
        />
      </div>
      <div class="nbody-slider-group">
        <div class="nbody-slider-label">
          <span>Gravity Constant (G)</span><span id="nbody-g-val">1.00</span>
        </div>
        <input
          type="range"
          id="nbody-gravity"
          min="0"
          max="2"
          step="0.01"
          value="1.0"
        />
      </div>
      <div class="nbody-slider-group">
        <div class="nbody-slider-label">
          <span>Step Size (dt)</span><span id="nbody-dt-val">0.05</span>
        </div>
        <input
          type="range"
          id="nbody-dt"
          min="0.01"
          max="0.5"
          step="0.01"
          value="0.05"
        />
      </div>
      <div class="nbody-slider-group">
        <div class="nbody-slider-label">
          <span>Merge Threshold</span><span id="nbody-merge-val">0.90</span>
        </div>
        <input
          type="range"
          id="nbody-merge-dist"
          min="0.1"
          max="5.0"
          step="0.1"
          value="0.9"
        />
      </div>
      <div class="nbody-slider-group">
        <div class="nbody-slider-label">
          <span>Trail Persistence</span><span id="nbody-trail-val">0.85</span>
        </div>
        <input
          type="range"
          id="nbody-trail-persistence"
          min="0.0"
          max="0.99"
          step="0.01"
          value="0.85"
        />
      </div>
    </div>

    <div class="nbody-buttons">
      <button id="nbody-reset" class="nbody-btn nbody-btn-primary">Reset</button
      >
      <button id="nbody-clear" class="nbody-btn nbody-btn-secondary"
        >Clear</button
      >
    </div>
  </div>

  <!-- Stats -->
  <div id="nbody-stats" class="nbody-ui-panel nbody-stats nbody-ui-hidden">
    Stars: <span id="nbody-star-count">0</span>
  </div>

  <!-- Fullscreen button -->
  <button
    id="nbody-fullscreen"
    class="nbody-fullscreen-btn"
    title="Toggle fullscreen"
  >
    <svg
      id="nbody-fs-icon-expand"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
    <svg
      id="nbody-fs-icon-collapse"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      style="display:none"
    >
      <polyline points="4 14 10 14 10 20"></polyline>
      <polyline points="20 10 14 10 14 4"></polyline>
      <line x1="14" y1="10" x2="21" y2="3"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </button>

  <!-- Hint -->
  <div id="nbody-hint" class="nbody-hint">
    Press <kbd>H</kbd> for controls · Double-click to spawn singularity · Click &amp;
    drag to attract
  </div>
</div>

<style>
  #nbody-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 1rem;
    overflow: hidden;
    cursor: crosshair;
    background: #0a0a0c;
    margin: 1.5rem 0;
  }
  #nbody-container:fullscreen {
    aspect-ratio: unset;
    border-radius: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
  }
  #nbody-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nbody-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    color: rgba(131, 145, 246, 0.45);
    font-family: "Inter", system-ui, sans-serif;
    pointer-events: none;
    white-space: nowrap;
  }
  .nbody-hint kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    padding: 0 4px;
    font-size: 0.6rem;
  }

  .nbody-ui-panel {
    background: rgba(37, 38, 39, 0.92);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    font-family: "Inter", system-ui, sans-serif;
  }
  .nbody-ui-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
  }

  .nbody-controls {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 1.25rem;
    border-radius: 1rem;
    width: 280px;
    z-index: 10;
    color: #e0e0e0;
  }
  .nbody-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.15rem 0;
    color: #a5b4fc;
  }
  .nbody-subtitle {
    font-size: 0.6rem;
    color: #9ca3af;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nbody-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 1.25rem;
    padding: 4px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
  }
  .nbody-tab {
    flex: 1;
    padding: 0.35rem 0;
    font-size: 0.6rem;
    font-weight: 700;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .nbody-tab.tab-active {
    background: #8391f6;
    color: white;
  }
  .nbody-tab.tab-inactive {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.5);
  }
  .nbody-tab.tab-inactive:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .nbody-sliders {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .nbody-slider-group input[type="range"] {
    width: 100%;
    accent-color: #8391f6;
  }
  .nbody-slider-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    margin-bottom: 0.2rem;
    color: #d1d5db;
  }

  .nbody-buttons {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }
  .nbody-btn {
    flex: 1;
    padding: 0.45rem 0;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    font-family: inherit;
  }
  .nbody-btn-primary {
    background: #4f46e5;
    color: white;
  }
  .nbody-btn-primary:hover {
    background: #6366f1;
  }
  .nbody-btn-secondary {
    background: #27272a;
    color: white;
  }
  .nbody-btn-secondary:hover {
    background: #3f3f46;
  }

  .nbody-stats {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-family: "SF Mono", "Fira Code", monospace;
    color: rgba(165, 180, 252, 0.5);
    z-index: 10;
  }

  .nbody-fullscreen-btn {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: rgba(165, 180, 252, 0.6);
    padding: 6px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
  .nbody-fullscreen-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(165, 180, 252, 0.9);
  }
</style>

<script is:inline>
  (function () {
    const container = document.getElementById("nbody-container");
    const canvas = document.getElementById("nbody-canvas");
    const ctx = canvas.getContext("2d");
    const uiContainer = document.getElementById("nbody-ui");
    const statsEl = document.getElementById("nbody-stats");
    const hintEl = document.getElementById("nbody-hint");

    const countInput = document.getElementById("nbody-particle-count");
    const countVal = document.getElementById("nbody-count-val");
    const gInput = document.getElementById("nbody-gravity");
    const gVal = document.getElementById("nbody-g-val");
    const dtInput = document.getElementById("nbody-dt");
    const dtVal = document.getElementById("nbody-dt-val");
    const mergeInput = document.getElementById("nbody-merge-dist");
    const mergeVal = document.getElementById("nbody-merge-val");
    const trailInput = document.getElementById("nbody-trail-persistence");
    const trailVal = document.getElementById("nbody-trail-val");
    const resetBtn = document.getElementById("nbody-reset");
    const clearBtn = document.getElementById("nbody-clear");
    const starCountDisplay = document.getElementById("nbody-star-count");

    let particles = [];
    let G = 1.0;
    let dt = 0.05;
    let mergeThreshold = 0.9;
    let trailPersistence = 0.85;
    let targetCount = 800;
    let isUiVisible = false;
    let currentInitType = "disk";

    let simState = "running";
    let expansionAlpha = 0;
    let finalStar = null;

    const palette = [
      { h: 233, s: 95, l: 65 },
      { h: 281, s: 75, l: 15 },
      { h: 161, s: 45, l: 75 },
      { h: 349, s: 80, l: 55 },
      { h: 60, s: 100, l: 94 },
      { h: 0, s: 0, l: 100 },
      { h: 210, s: 10, l: 4 },
    ];

    let currentBgColor = palette[6];
    let previousBgColor = palette[6];
    let mouse = { x: 0, y: 0, active: false };
    let animFrameId = null;

    class Particle {
      constructor(x, y, vx, vy, mass, colorObj) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.lx = x;
        this.ly = y;
        this.ax = 0;
        this.ay = 0;
        this.mass = mass;
        this.updateRadius();
        this.dead = false;
        if (colorObj) {
          this.colorData = colorObj;
        } else {
          let choices = palette.filter(
            (c) => Math.abs(c.l - currentBgColor.l) > 30,
          );
          if (choices.length === 0)
            choices = palette.filter((c) => c.l !== currentBgColor.l);
          this.colorData = choices[Math.floor(Math.random() * choices.length)];
        }
        this.color = `hsla(${this.colorData.h}, ${this.colorData.s}%, ${this.colorData.l}%, 0.98)`;
      }
      updateRadius() {
        this.radius = Math.max(1.3, Math.sqrt(this.mass) * 0.5);
      }
      draw(overrideRadius) {
        const r = overrideRadius || this.radius;
        const sx = this.x + canvas.width / 2;
        const sy = this.y + canvas.height / 2;
        const lsx = this.lx + canvas.width / 2;
        const lsy = this.ly + canvas.height / 2;
        if (
          !overrideRadius &&
          Math.abs(this.x - this.lx) < canvas.width / 2 &&
          Math.abs(this.y - this.ly) < canvas.height / 2
        ) {
          ctx.beginPath();
          ctx.moveTo(lsx, lsy);
          ctx.lineTo(sx, sy);
          ctx.strokeStyle = this.color;
          ctx.lineWidth = r * 2.2;
          ctx.lineCap = "round";
          ctx.stroke();
        }
        ctx.beginPath();
        ctx.arc(sx, sy, r, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.fill();
      }
    }

    function setInitType(type) {
      currentInitType = type;
      document.querySelectorAll(".nbody-tab").forEach((btn) => {
        btn.className =
          btn.id === `tab-${type}`
            ? "nbody-tab tab-active"
            : "nbody-tab tab-inactive";
      });
      init(currentBgColor);
    }

    function resizeCanvas() {
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
    }

    function init(newBgColorData) {
      resizeCanvas();
      if (newBgColorData) {
        previousBgColor = { ...currentBgColor };
        currentBgColor = { ...newBgColorData };
      }
      particles = [];
      simState = "running";
      expansionAlpha = 0;
      finalStar = null;
      spawnParticles(targetCount, currentInitType);
      ctx.fillStyle = `hsla(${currentBgColor.h}, ${currentBgColor.s}%, ${currentBgColor.l}%, 1)`;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function spawnParticles(num, type) {
      const radius = Math.min(canvas.width, canvas.height) * 0.35;
      if (type === "disk") {
        for (let i = 0; i < num; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = 50 + Math.random() * radius;
          const vMag = Math.sqrt((G * 3000) / (dist + 20)) * 0.8;
          particles.push(
            new Particle(
              Math.cos(angle) * dist,
              Math.sin(angle) * dist,
              Math.cos(angle + Math.PI / 2) * vMag,
              Math.sin(angle + Math.PI / 2) * vMag,
              1 + Math.random() * 8,
            ),
          );
        }
      } else if (type === "binary") {
        const half = Math.floor(num / 2);
        const offset = radius * 0.6;
        for (let i = 0; i < half; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.random() * (radius * 0.4);
          const x = -offset + Math.cos(angle) * dist;
          const y = Math.sin(angle) * dist;
          const vMag = Math.sqrt((G * 1500) / (dist + 10)) * 0.5;
          particles.push(
            new Particle(
              x,
              y,
              Math.cos(angle + Math.PI / 2) * vMag,
              Math.sin(angle + Math.PI / 2) * vMag - 1,
              1 + Math.random() * 6,
            ),
          );
        }
        for (let i = 0; i < half; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.random() * (radius * 0.4);
          const x = offset + Math.cos(angle) * dist;
          const y = Math.sin(angle) * dist;
          const vMag = Math.sqrt((G * 1500) / (dist + 10)) * 0.5;
          particles.push(
            new Particle(
              x,
              y,
              Math.cos(angle + Math.PI / 2) * vMag,
              Math.sin(angle + Math.PI / 2) * vMag + 1,
              1 + Math.random() * 6,
            ),
          );
        }
      } else if (type === "grid") {
        const dim = Math.floor(Math.sqrt(num));
        const spacing = (radius * 2) / dim;
        for (let i = 0; i < dim; i++) {
          for (let j = 0; j < dim; j++) {
            particles.push(
              new Particle(
                (i - dim / 2) * spacing,
                (j - dim / 2) * spacing,
                0,
                0,
                2 + Math.random() * 4,
              ),
            );
          }
        }
      } else if (type === "chaos") {
        for (let i = 0; i < num; i++) {
          particles.push(
            new Particle(
              (Math.random() - 0.5) * canvas.width,
              (Math.random() - 0.5) * canvas.height,
              (Math.random() - 0.5) * 4,
              (Math.random() - 0.5) * 4,
              1 + Math.random() * 10,
            ),
          );
        }
      }
    }

    function updatePhysics() {
      if (simState !== "running") return;
      const halfW = canvas.width / 2;
      const halfH = canvas.height / 2;
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];
        if (p1.dead) continue;
        p1.lx = p1.x;
        p1.ly = p1.y;
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          if (p2.dead) continue;
          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const distSq = dx * dx + dy * dy;
          const dist = Math.sqrt(distSq);
          if (dist < (p1.radius + p2.radius) * mergeThreshold) {
            const totalMass = p1.mass + p2.mass;
            p1.vx = (p1.vx * p1.mass + p2.vx * p2.mass) / totalMass;
            p1.vy = (p1.vy * p1.mass + p2.vy * p2.mass) / totalMass;
            p1.x = (p1.x * p1.mass + p2.x * p2.mass) / totalMass;
            p1.y = (p1.y * p1.mass + p2.y * p2.mass) / totalMass;
            if (p2.mass > p1.mass) p1.colorData = p2.colorData;
            p1.mass = totalMass;
            p1.updateRadius();
            p1.color = `hsla(${p1.colorData.h}, ${p1.colorData.s}%, ${p1.colorData.l}%, 0.98)`;
            p2.dead = true;
            continue;
          }
          const force = (G * p1.mass * p2.mass) / (distSq + 400);
          const fX = (dx / (dist + 1)) * force;
          const fY = (dy / (dist + 1)) * force;
          p1.vx += (fX / p1.mass) * dt;
          p1.vy += (fY / p1.mass) * dt;
          p2.vx -= (fX / p2.mass) * dt;
          p2.vy -= (fY / p2.mass) * dt;
        }
        if (mouse.active) {
          const dx = mouse.x - halfW - p1.x,
            dy = mouse.y - halfH - p1.y;
          const distSq = dx * dx + dy * dy + 1000;
          const mForce = (G * p1.mass * 20000) / distSq;
          p1.vx += (dx / Math.sqrt(distSq)) * (mForce / p1.mass) * dt;
          p1.vy += (dy / Math.sqrt(distSq)) * (mForce / p1.mass) * dt;
        }
        p1.x += p1.vx * dt;
        p1.y += p1.vy * dt;
        p1.vx *= 0.9995;
        p1.vy *= 0.9995;
        if (p1.x < -halfW) {
          p1.x = halfW;
          p1.lx = halfW;
        }
        if (p1.x > halfW) {
          p1.x = -halfW;
          p1.lx = -halfW;
        }
        if (p1.y < -halfH) {
          p1.y = halfH;
          p1.ly = halfH;
        }
        if (p1.y > halfH) {
          p1.y = -halfH;
          p1.ly = -halfH;
        }
      }
      particles = particles.filter((p) => !p.dead);
      if (particles.length === 1) {
        simState = "expanding";
        finalStar = particles[0];
      }
    }

    function draw() {
      if (simState === "running") {
        const alpha = Math.max(0.01, 1 - trailPersistence);
        ctx.fillStyle = `hsla(${currentBgColor.h}, 0%, ${currentBgColor.l}%, ${alpha})`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => p.draw());
      } else if (simState === "expanding") {
        ctx.fillStyle = `hsla(${currentBgColor.h}, ${currentBgColor.s}%, ${currentBgColor.l}%, 0.1)`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        expansionAlpha += 0.015;
        const maxDim = Math.max(canvas.width, canvas.height) * 2;
        const r = finalStar.radius + expansionAlpha * expansionAlpha * maxDim;
        finalStar.draw(r);
        if (r > maxDim) init(finalStar.colorData);
      }
    }

    function loop() {
      updatePhysics();
      draw();
      starCountDisplay.innerText = particles.length;
      animFrameId = requestAnimationFrame(loop);
    }

    // --- Mouse relative to canvas ---
    function getCanvasPos(e) {
      const rect = canvas.getBoundingClientRect();
      return {
        x: (e.clientX - rect.left) * (canvas.width / rect.width),
        y: (e.clientY - rect.top) * (canvas.height / rect.height),
      };
    }

    canvas.addEventListener("mousedown", (e) => {
      const pos = getCanvasPos(e);
      mouse.active = true;
      mouse.x = pos.x;
      mouse.y = pos.y;
    });
    canvas.addEventListener("mousemove", (e) => {
      const pos = getCanvasPos(e);
      mouse.x = pos.x;
      mouse.y = pos.y;
    });
    window.addEventListener("mouseup", () => {
      mouse.active = false;
    });

    // Touch support
    canvas.addEventListener(
      "touchstart",
      (e) => {
        e.preventDefault();
        const touch = e.touches[0];
        const pos = getCanvasPos(touch);
        mouse.active = true;
        mouse.x = pos.x;
        mouse.y = pos.y;
      },
      { passive: false },
    );
    canvas.addEventListener(
      "touchmove",
      (e) => {
        e.preventDefault();
        const touch = e.touches[0];
        const pos = getCanvasPos(touch);
        mouse.x = pos.x;
        mouse.y = pos.y;
      },
      { passive: false },
    );
    canvas.addEventListener("touchend", () => {
      mouse.active = false;
    });

    window.addEventListener("keydown", (e) => {
      if (e.key.toLowerCase() === "h") {
        isUiVisible = !isUiVisible;
        uiContainer.classList.toggle("nbody-ui-hidden", !isUiVisible);
        statsEl.classList.toggle("nbody-ui-hidden", !isUiVisible);
        hintEl.style.opacity = isUiVisible ? "0" : "1";
      }
    });

    canvas.addEventListener("dblclick", (e) => {
      if (simState === "running") {
        const pos = getCanvasPos(e);
        particles.push(
          new Particle(
            pos.x - canvas.width / 2,
            pos.y - canvas.height / 2,
            0,
            0,
            5000,
            palette[5],
          ),
        );
      }
    });

    // Tab buttons
    document.querySelectorAll(".nbody-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const type = btn.id.replace("tab-", "");
        setInitType(type);
      });
    });

    countInput.addEventListener("change", (e) => {
      targetCount = parseInt(e.target.value);
      countVal.innerText = targetCount;
      init(currentBgColor);
    });
    gInput.addEventListener("input", (e) => {
      G = parseFloat(e.target.value);
      gVal.innerText = G.toFixed(2);
    });
    dtInput.addEventListener("input", (e) => {
      dt = parseFloat(e.target.value);
      dtVal.innerText = dt.toFixed(2);
    });
    mergeInput.addEventListener("input", (e) => {
      mergeThreshold = parseFloat(e.target.value);
      mergeVal.innerText = mergeThreshold.toFixed(2);
    });
    trailInput.addEventListener("input", (e) => {
      trailPersistence = parseFloat(e.target.value);
      trailVal.innerText = trailPersistence.toFixed(2);
    });
    resetBtn.addEventListener("click", () => init(palette[6]));
    clearBtn.addEventListener("click", () => {
      particles = [];
    });

    // Fullscreen
    const fsBtn = document.getElementById("nbody-fullscreen");
    const fsIconExpand = document.getElementById("nbody-fs-icon-expand");
    const fsIconCollapse = document.getElementById("nbody-fs-icon-collapse");

    fsBtn.addEventListener("click", () => {
      if (!document.fullscreenElement) {
        container.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen();
      }
    });

    document.addEventListener("fullscreenchange", () => {
      const isFs = document.fullscreenElement === container;
      fsIconExpand.style.display = isFs ? "none" : "block";
      fsIconCollapse.style.display = isFs ? "block" : "none";
      // Give the browser a frame to apply fullscreen layout, then resize canvas
      requestAnimationFrame(() => {
        resizeCanvas();
        ctx.fillStyle = `hsla(${currentBgColor.h}, ${currentBgColor.s}%, ${currentBgColor.l}%, 1)`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      });
    });

    // Intersection Observer – only animate when visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!animFrameId) loop();
          } else {
            if (animFrameId) {
              cancelAnimationFrame(animFrameId);
              animFrameId = null;
            }
          }
        });
      },
      { threshold: 0.1 },
    );
    observer.observe(container);

    // Resize handling
    let resizeTimeout;
    new ResizeObserver(() => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        resizeCanvas();
        ctx.fillStyle = `hsla(${currentBgColor.h}, ${currentBgColor.s}%, ${currentBgColor.l}%, 1)`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }, 150);
    }).observe(container);

    init();
  })();
</script>
